[{"id":"cervix:cervix","glossary":"cervix","term_en":"cervix","term_ru":"шейка матки","pronunciation_ru":"СЁР-викс","definition_ru":"Нижняя часть матки длиной около 3 см; включает экзоцервикс и эндоцервикс.","tags":["anatomy","cervix","uterus"],"related":["uterus:cervix","uterus:corpus","uterus:external_os","uterus:fundus","uterus:internal_os","uterus:leiomyoma","uterus:perimetrium","uterus:uterovaginal_plexus","uterus:uterus","uterus:vesicouterine_pouch"]},{"id":"cervix:ectocervix","glossary":"cervix","term_en":"ectocervix (portio vaginalis)","term_ru":"экзоцервикс; влагалищная часть шейки матки","pronunciation_ru":"эк-тоу-СЁР-викс","definition_ru":"Часть шейки матки, выступающая во влагалище и покрытая неороговевающим многослойным плоским эпителием.","tags":["anatomy","histology","cervix","epithelium"],"related":["cervix:cervical_ectopy","cervix:endocervix","cervix:squamous_metaplasia","ovaries:surface_epithelium","vagina:nonkeratinized_epithelium","vulva:keratinized_epithelium"]},{"id":"cervix:endocervix","glossary":"cervix","term_en":"endocervix (cervical canal)","term_ru":"эндоцервикс; цервикальный канал","pronunciation_ru":"эн-до-СЁР-викс","definition_ru":"Канал шейки матки, выстланный высоким слизепродуцирующим цилиндрическим эпителием.","tags":["anatomy","histology","cervix","epithelium"],"related":["cervix:cervical_ectopy","cervix:ectocervix"]},{"id":"cervix:squamocolumnar_junction","glossary":"cervix","term_en":"squamocolumnar junction (SCJ)","term_ru":"плоскоцилиндрический стык","pronunciation_ru":"сквЭЙ-мо-ко-ЛАМ-нэр джАНК-шэн","definition_ru":"Граница между плоским эпителием экзоцервикса и цилиндрическим эпителием эндоцервикса.","tags":["histology","cervix","epithelium","oncology"],"related":["cervix:cervical_cancer","cervix:cervical_ectopy"]},{"id":"cervix:transformation_zone","glossary":"cervix","term_en":"transformation zone (T-zone)","term_ru":"зона трансформации шейки матки","pronunciation_ru":"транс-фэр-МЭЙ-шэн зоун","definition_ru":"Область плоскоклеточной метаплазии; в лекции указана как уязвимое место для ВПЧ-инфекции и неоплазии.","tags":["histology","cervix","hpv","oncology"],"related":["cervix:cervical_cancer","cervix:cin"]},{"id":"cervix:squamous_metaplasia","glossary":"cervix","term_en":"squamous metaplasia","term_ru":"плоскоклеточная метаплазия","pronunciation_ru":"СКВЭЙ-мэс мэт-э-ПЛЭЙ-жа","definition_ru":"Замещение одного типа эпителия плоским; в лекции описано в зоне трансформации шейки матки.","tags":["histology","cervix","epithelium"],"related":["cervix:cervical_ectopy","cervix:ectocervix"]},{"id":"cervix:nabothian_cysts","glossary":"cervix","term_en":"Nabothian cysts","term_ru":"наботовы кисты","pronunciation_ru":"нэ-БОУ-ти-эн систс","definition_ru":"Ретенционные кисты, возникающие при закупорке желёз шейки матки.","tags":["pathology","cervix","glands"],"related":["uterus:cervix","uterus:endometrial_glands"]},{"id":"cervix:cervical_mucus","glossary":"cervix","term_en":"cervical mucus","term_ru":"цервикальная слизь","pronunciation_ru":"СЁР-ви-кэл МЬЮ-кэс","definition_ru":"Секрет шейки матки: под влиянием эстрогенов становится водянистым и растяжимым, под влиянием прогестерона — густым.","tags":["physiology","cervix","fertility","hormones"],"related":["cervix:ferning","cervix:spinnbarkeit","cycle:amh","ovaries:hypoestrogenism","ovaries:osteoporosis","ovaries:ovary"]},{"id":"cervix:spinnbarkeit","glossary":"cervix","term_en":"spinnbarkeit","term_ru":"симптом растяжения цервикальной слизи","pronunciation_ru":"шпин-БАР-кайт","definition_ru":"Свойство цервикальной слизи растягиваться под влиянием эстрогенов в середине цикла.","tags":["physiology","cervix","fertility"],"related":["cervix:cervical_mucus","cervix:ferning"]},{"id":"cervix:ferning","glossary":"cervix","term_en":"ferning (arborization) test","term_ru":"симптом папоротника; кристаллизация слизи","pronunciation_ru":"ФЁР-нинг","definition_ru":"Рисунок кристаллизации цервикальной слизи, связанный в лекции с эстрогенным влиянием и фертильным периодом.","tags":["diagnostics","cervix","fertility"],"related":["cervix:cervical_mucus","cervix:spinnbarkeit"]},{"id":"cervix:cervical_plug","glossary":"cervix","term_en":"cervical plug","term_ru":"слизистая пробка","pronunciation_ru":"СЁР-ви-кэл ПЛАГ","definition_ru":"Густая цервикальная слизь под влиянием прогестерона, препятствующая восходящему инфицированию.","tags":["physiology","cervix","pregnancy"],"related":["cervix:cerclage","cervix:cervical_insufficiency"]},{"id":"cervix:cervical_ectopy","glossary":"cervix","term_en":"cervical ectopy (ectropion)","term_ru":"эктопия шейки матки; эктропион","pronunciation_ru":"СЁР-ви-кэл ЭК-тоу-пи","definition_ru":"Состояние, при котором цилиндрический эпителий виден на наружной поверхности шейки; в молодом возрасте может быть физиологическим.","tags":["pathology","cervix","epithelium"],"related":["cervix:ectocervix","cervix:endocervix","cervix:squamocolumnar_junction","cervix:squamous_metaplasia","ovaries:surface_epithelium","vagina:nonkeratinized_epithelium","vulva:keratinized_epithelium"]},{"id":"cervix:cervicitis","glossary":"cervix","term_en":"cervicitis","term_ru":"цервицит","pronunciation_ru":"сёр-ви-САЙ-тис","definition_ru":"Воспаление шейки матки; в лекции названы Chlamydia trachomatis и Neisseria gonorrhoeae.","tags":["pathology","cervix","inflammation","infection"],"related":["tubes:pid","tubes:salpingitis","vulva:vulvovaginitis"]},{"id":"cervix:cin","glossary":"cervix","term_en":"cervical intraepithelial neoplasia (CIN)","term_ru":"цервикальная интраэпителиальная неоплазия","pronunciation_ru":"СЁР-ви-кэл ин-тра-э-пи-ТИ-ли-эл ни-о-ПЛЭЙ-жа","definition_ru":"Предраковое поражение эпителия шейки матки; лекция перечисляет степени CIN I–III.","tags":["pathology","cervix","oncology","hpv"],"related":["cervix:cervical_cancer","cervix:colposcopy","cervix:hpv","cervix:hpv_testing","cervix:schiller_test","cervix:transformation_zone"]},{"id":"cervix:lsil","glossary":"cervix","term_en":"low-grade squamous intraepithelial lesion (LSIL)","term_ru":"плоскоклеточное интраэпителиальное поражение низкой степени","pronunciation_ru":"лоу-грэйд сквЭЙ-мэс ин-тра-э-пи-ТИ-ли-эл ЛИ-жэн","definition_ru":"Категория Bethesda для плоскоклеточного поражения низкой степени, приведённая в лекции.","tags":["diagnostics","cervix","oncology","cytology"],"related":["cervix:hsil","cervix:pap_smear"]},{"id":"cervix:hsil","glossary":"cervix","term_en":"high-grade squamous intraepithelial lesion (HSIL)","term_ru":"плоскоклеточное интраэпителиальное поражение высокой степени","pronunciation_ru":"хай-грэйд сквЭЙ-мэс ин-тра-э-пи-ТИ-ли-эл ЛИ-жэн","definition_ru":"Категория Bethesda для плоскоклеточного поражения высокой степени, приведённая в лекции.","tags":["diagnostics","cervix","oncology","cytology"],"related":["cervix:lsil","cervix:pap_smear"]},{"id":"cervix:cervical_cancer","glossary":"cervix","term_en":"cervical cancer","term_ru":"рак шейки матки","pronunciation_ru":"СЁР-ви-кэл КЭН-сэр","definition_ru":"Злокачественная опухоль шейки матки; лекция связывает её с ВПЧ высокого риска, в том числе типов 16 и 18.","tags":["pathology","cervix","oncology","hpv"],"related":["cervix:cin","cervix:colposcopy","cervix:hpv","cervix:hpv_testing","cervix:schiller_test","cervix:squamocolumnar_junction","cervix:transformation_zone","tubes:tubal_cancer","vagina:vaginal_cancer","vagina:vaginal_fornices"]},{"id":"cervix:hpv","glossary":"cervix","term_en":"human papillomavirus (HPV)","term_ru":"вирус папилломы человека (ВПЧ)","pronunciation_ru":"ХЬЮ-мэн пэ-пи-ЛОУ-ма-вай-рэс","definition_ru":"Вирус, высокорисковые типы которого связаны с неоплазией шейки матки; в лекции упомянуты 16 и 18 типы.","tags":["pathology","cervix","hpv","oncology"],"related":["cervix:cervical_cancer","cervix:cin"]},{"id":"cervix:pap_smear","glossary":"cervix","term_en":"Pap smear (Papanicolaou test)","term_ru":"мазок по Папаниколау; цитологический мазок","pronunciation_ru":"ПЭП смир","definition_ru":"Цитологическое исследование клеток шейки матки, указанное в лекции для профилактического выявления поражений.","tags":["diagnostics","cervix","cytology","oncology"],"related":["cervix:hsil","cervix:lsil"]},{"id":"cervix:hpv_testing","glossary":"cervix","term_en":"HPV testing","term_ru":"тестирование на ВПЧ","pronunciation_ru":"эйч-пи-ВИ ТЭС-тинг","definition_ru":"Исследование на вирус папилломы человека, перечисленное в лекции в профилактике и диагностике рака шейки матки.","tags":["diagnostics","cervix","hpv","oncology"],"related":["cervix:cervical_cancer","cervix:cin"]},{"id":"cervix:colposcopy","glossary":"cervix","term_en":"colposcopy","term_ru":"кольпоскопия","pronunciation_ru":"кол-ПОС-ко-пи","definition_ru":"Осмотр шейки матки с увеличением; в лекции упомянуты проба Шиллера и тест с уксусной кислотой.","tags":["diagnostics","cervix","oncology"],"related":["cervix:cervical_cancer","cervix:cin"]},{"id":"cervix:schiller_test","glossary":"cervix","term_en":"Schiller test","term_ru":"проба Шиллера","pronunciation_ru":"ШИЛ-эр тэст","definition_ru":"Проба, указанная в лекции как часть кольпоскопического обследования.","tags":["diagnostics","cervix","oncology"],"related":["cervix:cervical_cancer","cervix:cin"]},{"id":"cervix:cervical_insufficiency","glossary":"cervix","term_en":"cervical insufficiency","term_ru":"истмико-цервикальная недостаточность","pronunciation_ru":"СЁР-ви-кэл ин-сэ-ФИ-шэн-си","definition_ru":"Недостаточность шейки матки, связанная в лекции с повторными потерями беременности во втором триместре.","tags":["pathology","cervix","pregnancy","obstetrics"],"related":["cervix:cerclage","cervix:cervical_plug","pelvis:uterine_rupture","tubes:amenorrhea","uterus:lower_segment","vulva:pudendal_block","vulva:vulvar_varicosities"]},{"id":"cervix:cerclage","glossary":"cervix","term_en":"cerclage","term_ru":"серкляж; наложение шва на шейку матки","pronunciation_ru":"сэр-КЛАЖ","definition_ru":"Метод поддержки шейки матки швом, упомянутый в лекции при её недостаточности.","tags":["clinical","cervix","pregnancy","surgery"],"related":["cervix:cervical_insufficiency","cervix:cervical_plug","tubes:amenorrhea","tubes:methotrexate","vagina:colpotomy","vagina:vaginal_fornices","vulva:vulvar_varicosities"]}]