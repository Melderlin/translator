[{"id":"uterus:basal_layer","glossary":"uterus","term_en":"basal layer (stratum basale)","term_ru":"базальный слой эндометрия","pronunciation_ru":"БЭЙ-сэл ЛЭЙ-эр","definition_ru":"Нижняя треть эндометрия; содержит основания желёз и обеспечивает регенерацию после менструации.","tags":["histology","uterus","endometrium","menstrual-cycle"],"related":["uterus:adenomyosis","uterus:endometrium","uterus:functional_layer","uterus:menstrual_phase"]},{"id":"uterus:endometrial_glands","glossary":"uterus","term_en":"endometrial glands","term_ru":"железы эндометрия","pronunciation_ru":"эн-до-МИ-три-эл глЭНДЗ","definition_ru":"Трубчатые железы слизистой матки; их форма меняется в течение менструального цикла.","tags":["histology","uterus","endometrium","glands"],"related":["cervix:nabothian_cysts","cycle:endometrial_biopsy","uterus:adenomyosis"]},{"id":"uterus:myometrium","glossary":"uterus","term_en":"myometrium","term_ru":"миометрий","pronunciation_ru":"май-о-МИ-три-эм","definition_ru":"Мышечная оболочка матки из гладких мышечных клеток; при беременности гипертрофируется и гиперплазируется.","tags":["anatomy","histology","uterus","muscle","pregnancy"],"related":["cycle:uterine_quiescence","uterus:decidualization"]},{"id":"uterus:perimetrium","glossary":"uterus","term_en":"perimetrium","term_ru":"периметрий","pronunciation_ru":"пэ-ри-МИ-три-эм","definition_ru":"Серозная оболочка матки, соответствующая висцеральной брюшине.","tags":["anatomy","histology","uterus"],"related":["cervix:cervix","cycle:endometrial_biopsy"]},{"id":"uterus:menstrual_phase","glossary":"uterus","term_en":"menstrual phase","term_ru":"менструальная фаза","pronunciation_ru":"МЭН-стру-эл фэйз","definition_ru":"Начальная фаза цикла; снижение прогестерона связано со спазмом спиральных артерий, ишемией и отторжением функционального слоя.","tags":["physiology","uterus","endometrium","menstrual-cycle"],"related":["uterus:adenomyosis","uterus:basal_layer"]},{"id":"uterus:proliferative_phase","glossary":"uterus","term_en":"proliferative phase","term_ru":"фаза пролиферации","pronunciation_ru":"про-ЛИ-фэ-рэ-тив фэйз","definition_ru":"Фаза под преобладанием эстрогенов, во время которой эндометрий утолщается и железы имеют прямой ход.","tags":["physiology","uterus","endometrium","menstrual-cycle","hormones"],"related":["cycle:menstrual_cycle","uterus:secretory_phase"]},{"id":"uterus:secretory_phase","glossary":"uterus","term_en":"secretory phase","term_ru":"фаза секреции","pronunciation_ru":"СИ-крэ-то-ри фэйз","definition_ru":"Фаза под влиянием прогестерона; описаны извитые «пилообразные» железы, отёк стромы и подготовка к имплантации.","tags":["physiology","uterus","endometrium","menstrual-cycle","hormones"],"related":["cycle:menstrual_cycle","uterus:proliferative_phase"]},{"id":"uterus:implantation_window","glossary":"uterus","term_en":"implantation window","term_ru":"окно имплантации","pronunciation_ru":"им-плэн-ТЭЙ-шэн УИН-доу","definition_ru":"Период восприимчивости эндометрия к имплантации; в лекции указаны дни 20–24 цикла.","tags":["physiology","uterus","endometrium","fertility"],"related":["cycle:endometrial_biopsy","tubes:hysterosalpingography","uterus:endometriosis"]},{"id":"uterus:decidualization","glossary":"uterus","term_en":"decidualization","term_ru":"децидуализация","pronunciation_ru":"ди-ДЖУ-э-лай-ЗЭЙ-шэн","definition_ru":"Преобразование эндометрия в децидуальную ткань при беременности.","tags":["physiology","uterus","endometrium","pregnancy"],"related":["cycle:endometrial_biopsy","cycle:uterine_quiescence","uterus:gestational_trophoblastic_disease","uterus:hydatidiform_mole","uterus:isthmus","uterus:myometrium"]},{"id":"uterus:mullerian_anomalies","glossary":"uterus","term_en":"Müllerian duct anomalies","term_ru":"аномалии мюллеровых протоков","pronunciation_ru":"мью-ЛИ-ри-эн дак э-НОМ-э-лиз","definition_ru":"Группа врождённых аномалий формирования матки, включающая перечисленные в лекции двойную, двурогую, однорогую матку и матку с перегородкой.","tags":["pathology","uterus","congenital"],"related":["uterus:bicornuate_uterus","uterus:septate_uterus","uterus:unicornuate_uterus","uterus:uterus_didelphys"]},{"id":"uterus:uterus_didelphys","glossary":"uterus","term_en":"uterus didelphys","term_ru":"двойная матка","pronunciation_ru":"Ю-тэ-рэс дай-ДЭЛ-фис","definition_ru":"Вариант аномалии мюллеровых протоков.","tags":["pathology","uterus","congenital"],"related":["uterus:bicornuate_uterus","uterus:mullerian_anomalies"]},{"id":"uterus:bicornuate_uterus","glossary":"uterus","term_en":"bicornuate uterus","term_ru":"двурогая матка","pronunciation_ru":"бай-КОР-ню-эт Ю-тэ-рэс","definition_ru":"Врождённая аномалия формы матки с двумя рогами.","tags":["pathology","uterus","congenital"],"related":["uterus:mullerian_anomalies","uterus:septate_uterus","uterus:unicornuate_uterus","uterus:uterus_didelphys","vulva:imperforate_hymen"]},{"id":"uterus:septate_uterus","glossary":"uterus","term_en":"septate uterus","term_ru":"матка с перегородкой","pronunciation_ru":"СЭП-тэйт Ю-тэ-рэс","definition_ru":"Врождённая аномалия, при которой полость матки разделена перегородкой.","tags":["pathology","uterus","congenital"],"related":["uterus:bicornuate_uterus","uterus:mullerian_anomalies"]},{"id":"uterus:unicornuate_uterus","glossary":"uterus","term_en":"unicornuate uterus","term_ru":"однорогая матка","pronunciation_ru":"ю-ни-КОР-ню-эт Ю-тэ-рэс","definition_ru":"Вариант аномалии мюллеровых протоков, упомянутый в лекции.","tags":["pathology","uterus","congenital"],"related":["uterus:bicornuate_uterus","uterus:mullerian_anomalies"]},{"id":"uterus:leiomyoma","glossary":"uterus","term_en":"leiomyoma (uterine fibroid)","term_ru":"лейомиома; миома матки","pronunciation_ru":"лай-о-май-ОУ-ма (Ю-тэ-рин ФАЙ-броид)","definition_ru":"Доброкачественная опухоль гладкой мускулатуры матки; в лекции перечислены субсерозный, интрамуральный и субмукозный варианты.","tags":["pathology","uterus","benign-tumour"],"related":["cervix:cervix","cycle:endometrial_biopsy"]},{"id":"uterus:adenomyosis","glossary":"uterus","term_en":"adenomyosis","term_ru":"аденомиоз","pronunciation_ru":"э-ди-ноу-май-ОУ-сис","definition_ru":"Эктопические эндометриальные железы в миометрии; в лекции отмечены дисменорея и шаровидная матка.","tags":["pathology","uterus","endometrium","menstrual-cycle"],"related":["uterus:abnormal_uterine_bleeding","uterus:basal_layer","uterus:endometrial_glands","uterus:endometrial_polyp","uterus:endometritis","uterus:endometrium","uterus:functional_layer","uterus:menstrual_phase","uterus:spiral_arteries","uterus:uterine_cavity"]},{"id":"uterus:endometriosis","glossary":"uterus","term_en":"endometriosis","term_ru":"эндометриоз","pronunciation_ru":"эн-до-ми-три-ОУ-сис","definition_ru":"Наличие функционирующей эндометриальной ткани вне матки; в лекции приведён пример эндометриоидной кисты яичника.","tags":["pathology","uterus","endometrium","ovary","fertility"],"related":["cycle:amh","cycle:tvus","tubes:hysterosalpingography","uterus:implantation_window"]},{"id":"uterus:endometrial_hyperplasia","glossary":"uterus","term_en":"endometrial hyperplasia","term_ru":"гиперплазия эндометрия","pronunciation_ru":"эн-до-МИ-три-эл хай-пэр-ПЛЭЙ-жа","definition_ru":"Увеличение пролиферации эндометрия; лекция различает варианты с атипией и без неё и указывает на риск рака эндометрия.","tags":["pathology","uterus","endometrium","oncology"],"related":["cycle:endometrial_biopsy","uterus:endometrial_carcinoma"]},{"id":"uterus:endometrial_carcinoma","glossary":"uterus","term_en":"endometrial carcinoma","term_ru":"рак эндометрия","pronunciation_ru":"эн-до-МИ-три-эл кар-си-НО-ма","definition_ru":"Злокачественная опухоль эндометрия; лекция различает эндометриоидный тип I и серозный тип II.","tags":["pathology","uterus","endometrium","oncology"],"related":["cycle:endometrial_biopsy","uterus:endometrial_hyperplasia","uterus:uterine_sarcoma"]},{"id":"uterus:endometritis","glossary":"uterus","term_en":"endometritis","term_ru":"эндометрит","pronunciation_ru":"эн-до-ми-ТАЙ-тис","definition_ru":"Воспаление эндометрия, перечисленное в лекции среди заболеваний матки.","tags":["pathology","uterus","endometrium","inflammation"],"related":["cycle:endometrial_biopsy","uterus:adenomyosis"]},{"id":"uterus:asherman_syndrome","glossary":"uterus","term_en":"Asherman syndrome","term_ru":"синдром Ашермана","pronunciation_ru":"ЭШ-эр-мэн СИН-дроум","definition_ru":"Состояние, связанное с внутриматочными синехиями.","tags":["pathology","uterus","endometrium","infertility"],"related":["cycle:endometrial_biopsy","tubes:hydrosalpinx","uterus:intrauterine_adhesions"]},{"id":"uterus:intrauterine_adhesions","glossary":"uterus","term_en":"intrauterine adhesions","term_ru":"внутриматочные синехии","pronunciation_ru":"ин-тра-Ю-тэ-рин эд-ХИ-жэнз","definition_ru":"Спайки внутри полости матки; в лекции связаны с синдромом Ашермана.","tags":["pathology","uterus","endometrium","infertility"],"related":["cycle:endometrial_biopsy","uterus:asherman_syndrome"]},{"id":"uterus:endometrial_polyp","glossary":"uterus","term_en":"endometrial polyp","term_ru":"полип эндометрия","pronunciation_ru":"эн-до-МИ-три-эл ПО-лип","definition_ru":"Полиповидное образование эндометрия, перечисленное в лекции среди патологий.","tags":["pathology","uterus","endometrium"],"related":["cycle:endometrial_biopsy","uterus:adenomyosis"]},{"id":"uterus:abnormal_uterine_bleeding","glossary":"uterus","term_en":"abnormal uterine bleeding (AUB)","term_ru":"аномальное маточное кровотечение","pronunciation_ru":"эб-НОР-мэл Ю-тэ-рин БЛИ-динг","definition_ru":"Термин для патологического маточного кровотечения; лекция приводит классификацию PALM-COEIN.","tags":["pathology","uterus","menstrual-cycle","diagnostics"],"related":["cycle:menstrual_cycle","uterus:adenomyosis","uterus:palm_coein"]},{"id":"uterus:palm_coein","glossary":"uterus","term_en":"PALM-COEIN classification","term_ru":"классификация PALM-COEIN","pronunciation_ru":"ПЭЛМ-КОУ-ин клэс-и-фи-КЭЙ-шэн","definition_ru":"Классификация причин аномальных маточных кровотечений, представленная в лекции.","tags":["diagnostics","pathology","uterus","menstrual-cycle"],"related":["cycle:menstrual_cycle","uterus:abnormal_uterine_bleeding"]},{"id":"uterus:uterine_sarcoma","glossary":"uterus","term_en":"uterine sarcoma","term_ru":"саркома матки","pronunciation_ru":"Ю-тэ-рин сар-КОУ-ма","definition_ru":"Злокачественная опухоль матки, указанная в лекции среди патологий.","tags":["pathology","uterus","oncology"],"related":["cycle:endometrial_biopsy","uterus:endometrial_carcinoma"]},{"id":"uterus:gestational_trophoblastic_disease","glossary":"uterus","term_en":"gestational trophoblastic disease","term_ru":"гестационная трофобластическая болезнь","pronunciation_ru":"джэ-СТЭЙ-шэ-нэл троу-фо-БЛЭС-тик ди-ЗИЗ","definition_ru":"Группа патологических состояний трофобласта; лекция приводит пузырный занос как пример.","tags":["pathology","pregnancy","uterus"],"related":["cycle:uterine_quiescence","uterus:decidualization"]},{"id":"uterus:hydatidiform_mole","glossary":"uterus","term_en":"hydatidiform mole","term_ru":"пузырный занос","pronunciation_ru":"хай-дэ-ТИ-ди-фОРМ моул","definition_ru":"Форма гестационной трофобластической болезни, приведённая в лекции.","tags":["pathology","pregnancy","uterus"],"related":["cycle:uterine_quiescence","uterus:decidualization"]}]