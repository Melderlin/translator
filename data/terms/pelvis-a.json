[{"id":"pelvis:pelvis","glossary":"pelvis","term_en":"pelvis","term_ru":"таз","pronunciation_ru":"ПЭЛ-вис","definition_ru":"Костно-связочная область с большим и малым тазом; малый таз образует родовой канал.","tags":["anatomy","pelvis","obstetrics"],"related":["cycle:pelvimetry","pelvis:android_pelvis"]},{"id":"pelvis:pelvic_bones","glossary":"pelvis","term_en":"pelvic bones","term_ru":"тазовые кости","pronunciation_ru":"ПЭЛ-вик боунз","definition_ru":"Две тазовые кости, крестец и копчик формируют костную основу таза.","tags":["anatomy","pelvis","bone"],"related":["pelvis:acetabulum","pelvis:coccyx"]},{"id":"pelvis:hip_bone","glossary":"pelvis","term_en":"hip bone (innominate bone)","term_ru":"тазовая кость","pronunciation_ru":"ХИП боун (и-НО-ми-нит боун)","definition_ru":"Каждая тазовая кость состоит из подвздошной, седалищной и лобковой костей, соединяющихся в области вертлужной впадины.","tags":["anatomy","pelvis","bone"],"related":["pelvis:acetabulum","pelvis:coccyx"]},{"id":"pelvis:sacrum","glossary":"pelvis","term_en":"sacrum","term_ru":"крестец","pronunciation_ru":"СЭЙ-крэм","definition_ru":"Кость задней стенки таза; мыс крестца служит ориентиром входа в малый таз.","tags":["anatomy","pelvis","bone"],"related":["pelvis:acetabulum","pelvis:coccyx"]},{"id":"pelvis:coccyx","glossary":"pelvis","term_en":"coccyx","term_ru":"копчик","pronunciation_ru":"КОК-сикс","definition_ru":"Концевая часть позвоночника; участвует в формировании выхода из малого таза и может отклоняться кзади в родах.","tags":["anatomy","pelvis","bone","obstetrics"],"related":["cycle:pelvimetry","pelvis:acetabulum","pelvis:hip_bone","pelvis:ilium","pelvis:ischium","pelvis:pelvic_bones","pelvis:pubis","pelvis:rickets","pelvis:sacrum"]},{"id":"pelvis:ilium","glossary":"pelvis","term_en":"ilium","term_ru":"подвздошная кость","pronunciation_ru":"И-ли-эм","definition_ru":"Верхняя широкая часть тазовой кости.","tags":["anatomy","pelvis","bone"],"related":["pelvis:acetabulum","pelvis:coccyx"]},{"id":"pelvis:ischium","glossary":"pelvis","term_en":"ischium","term_ru":"седалищная кость","pronunciation_ru":"ИС-ки-эм","definition_ru":"Задненижняя часть тазовой кости; седалищные бугры участвуют в границах выхода из малого таза.","tags":["anatomy","pelvis","bone"],"related":["pelvis:acetabulum","pelvis:coccyx"]},{"id":"pelvis:pubis","glossary":"pelvis","term_en":"pubis","term_ru":"лобковая кость","pronunciation_ru":"ПЬЮ-бис","definition_ru":"Передняя часть тазовой кости; правая и левая стороны соединяются в лобковом симфизе.","tags":["anatomy","pelvis","bone"],"related":["pelvis:acetabulum","pelvis:coccyx"]},{"id":"pelvis:acetabulum","glossary":"pelvis","term_en":"acetabulum","term_ru":"вертлужная впадина","pronunciation_ru":"э-сэ-ТЭБ-ю-лэм","definition_ru":"Впадина тазовой кости, в которой соединяются её три костных компонента; участвует в формировании тазобедренного сустава.","tags":["anatomy","pelvis","bone","joint"],"related":["pelvis:coccyx","pelvis:hip_bone","pelvis:ilium","pelvis:ischium","pelvis:pelvic_bones","pelvis:pubic_symphysis","pelvis:pubis","pelvis:rickets","pelvis:sacrococcygeal_joint","pelvis:sacroiliac_joints","pelvis:sacrum"]},{"id":"pelvis:sacroiliac_joints","glossary":"pelvis","term_en":"sacroiliac joints","term_ru":"крестцово-подвздошные суставы","pronunciation_ru":"сэй-кроу-И-ли-эк джойнтс","definition_ru":"Суставы между крестцом и подвздошными костями.","tags":["anatomy","pelvis","joint"],"related":["pelvis:acetabulum","pelvis:pubic_symphysis"]},{"id":"pelvis:pubic_symphysis","glossary":"pelvis","term_en":"pubic symphysis","term_ru":"лобковый симфиз","pronunciation_ru":"ПЬЮ-бик СИМ-фи-сис","definition_ru":"Соединение правой и левой лобковых костей; при беременности подвижность сочленения может увеличиваться.","tags":["anatomy","pelvis","joint","pregnancy"],"related":["pelvis:acetabulum","pelvis:relaxin","pelvis:sacrococcygeal_joint","pelvis:sacroiliac_joints"]},{"id":"pelvis:sacrococcygeal_joint","glossary":"pelvis","term_en":"sacrococcygeal joint","term_ru":"крестцово-копчиковый сустав","pronunciation_ru":"сэй-кроу-КОК-си-джи-эл джойнт","definition_ru":"Соединение крестца с копчиком.","tags":["anatomy","pelvis","joint"],"related":["pelvis:acetabulum","pelvis:pubic_symphysis"]},{"id":"pelvis:relaxin","glossary":"pelvis","term_en":"relaxin","term_ru":"релаксин","pronunciation_ru":"ри-ЛЭК-син","definition_ru":"Гормон, который вместе с прогестероном связан в лекции с размягчением связок таза во время беременности.","tags":["physiology","hormones","pregnancy","pelvis"],"related":["cycle:uterine_quiescence","pelvis:pubic_symphysis"]},{"id":"pelvis:greater_pelvis","glossary":"pelvis","term_en":"false (greater) pelvis","term_ru":"большой таз","pronunciation_ru":"фОлс ГРЭЙ-тэр ПЭЛ-вис","definition_ru":"Часть таза выше пограничной линии; поддерживает увеличенную матку при беременности.","tags":["anatomy","pelvis","obstetrics"],"related":["cycle:pelvimetry","pelvis:android_pelvis"]},{"id":"pelvis:lesser_pelvis","glossary":"pelvis","term_en":"true (lesser) pelvis","term_ru":"малый таз","pronunciation_ru":"тРУ ЛЭ-сэр ПЭЛ-вис","definition_ru":"Часть таза, образующая родовой канал и включающая вход, полость и выход.","tags":["anatomy","pelvis","obstetrics","birth-canal"],"related":["pelvis:pelvic_inlet","pelvis:pelvic_outlet"]},{"id":"pelvis:linea_terminalis","glossary":"pelvis","term_en":"linea terminalis","term_ru":"пограничная линия","pronunciation_ru":"ЛИ-ни-э тёр-ми-НЭЙ-лис","definition_ru":"Линия, отделяющая большой таз от малого и участвующая в границах входа в малый таз.","tags":["anatomy","pelvis","obstetrics"],"related":["cycle:pelvimetry","pelvis:android_pelvis"]},{"id":"pelvis:pelvic_inlet","glossary":"pelvis","term_en":"pelvic inlet","term_ru":"вход в малый таз","pronunciation_ru":"ПЭЛ-вик ИН-лет","definition_ru":"Верхняя апертура малого таза; ограничена мысом крестца, пограничной линией и верхним краем лобкового симфиза.","tags":["anatomy","pelvis","obstetrics","birth-canal"],"related":["pelvis:lesser_pelvis","pelvis:pelvic_outlet"]},{"id":"pelvis:sacral_promontory","glossary":"pelvis","term_en":"sacral promontory","term_ru":"мыс крестца","pronunciation_ru":"СЭЙ-крэл пром-эн-ТО-ри","definition_ru":"Выступ крестца, входящий в границу входа в малый таз и служащий ориентиром для оценки его размеров.","tags":["anatomy","pelvis","obstetrics"],"related":["cycle:pelvimetry","pelvis:android_pelvis"]},{"id":"pelvis:pelvic_cavity","glossary":"pelvis","term_en":"pelvic cavity","term_ru":"полость малого таза","pronunciation_ru":"ПЭЛ-вик КЭ-ви-ти","definition_ru":"Пространство между входом и выходом малого таза; в лекции выделены широкая и узкая части.","tags":["anatomy","pelvis","obstetrics"],"related":["cycle:pelvimetry","pelvis:android_pelvis"]},{"id":"pelvis:pelvic_outlet","glossary":"pelvis","term_en":"pelvic outlet","term_ru":"выход из малого таза","pronunciation_ru":"ПЭЛ-вик АУТ-лет","definition_ru":"Нижняя апертура малого таза, ограниченная копчиком, седалищными буграми и лобковой дугой.","tags":["anatomy","pelvis","obstetrics","birth-canal"],"related":["pelvis:lesser_pelvis","pelvis:pelvic_inlet"]},{"id":"pelvis:conjugata_vera","glossary":"pelvis","term_en":"conjugata vera (obstetrica)","term_ru":"истинная, или акушерская, конъюгата","pronunciation_ru":"кон-джу-ГЭЙ-та ВИ-ра (об-СТЭ-три-ка)","definition_ru":"Переднезадний размер входа в малый таз; ориентир в лекции — не менее 11 см.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:contracted_pelvis","pelvis:diagonal_conjugate","pelvis:distantia_cristarum","pelvis:distantia_spinarum","pelvis:distantia_trochanterica","pelvis:external_conjugate","pelvis:intertuberous_diameter","pelvis:michaelis_rhomboid","pelvis:solovyov_index","pelvis:transverse_diameter"]},{"id":"pelvis:diagonal_conjugate","glossary":"pelvis","term_en":"diagonal conjugate","term_ru":"диагональная конъюгата","pronunciation_ru":"дай-ЭГ-э-нэл кон-джу-ГЭЙТ","definition_ru":"Размер таза, используемый для клинической оценки; истинная конъюгата примерно на 1,5–2 см меньше.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:transverse_diameter","glossary":"pelvis","term_en":"transverse diameter (pelvic inlet)","term_ru":"поперечный размер входа в малый таз","pronunciation_ru":"транс-ВЁРС дай-ЭМ-и-тэр","definition_ru":"Поперечный размер входа в таз; ориентир в лекции — около 13 см.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:anteroposterior_outlet","glossary":"pelvis","term_en":"anteroposterior diameter (outlet)","term_ru":"прямой размер выхода из малого таза","pronunciation_ru":"эн-ти-ри-ор-пос-ТИ-ри-ор дай-ЭМ-и-тэр","definition_ru":"Переднезадний размер выхода; в лекции указан диапазон от 9,5 до 11,5 см при отклонении копчика.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["cycle:pelvimetry","pelvis:conjugata_vera","pelvis:contracted_pelvis","pelvis:diagonal_conjugate","pelvis:distantia_cristarum","pelvis:distantia_spinarum","pelvis:distantia_trochanterica","pelvis:external_conjugate","pelvis:intertuberous_diameter","pelvis:michaelis_rhomboid","pelvis:solovyov_index","pelvis:transverse_diameter"]},{"id":"pelvis:intertuberous_diameter","glossary":"pelvis","term_en":"intertuberous (bi-ischial) diameter","term_ru":"межбугорный размер","pronunciation_ru":"ин-тэр-ТЬЮ-бэр-эс дай-ЭМ-и-тэр","definition_ru":"Поперечный размер выхода малого таза между седалищными буграми; ориентир в лекции — около 11 см.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:distantia_spinarum","glossary":"pelvis","term_en":"distantia spinarum","term_ru":"расстояние между передневерхними подвздошными остями","pronunciation_ru":"дис-ТЭН-ши-а спи-НЭЙ-рэм","definition_ru":"Наружный размер таза между передневерхними подвздошными остями; в лекции 25–26 см.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:distantia_cristarum","glossary":"pelvis","term_en":"distantia cristarum","term_ru":"расстояние между подвздошными гребнями","pronunciation_ru":"дис-ТЭН-ши-а крис-ТА-рэм","definition_ru":"Наружный поперечный размер между подвздошными гребнями; в лекции 28–29 см.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:distantia_trochanterica","glossary":"pelvis","term_en":"distantia trochanterica","term_ru":"межвертельное расстояние","pronunciation_ru":"дис-ТЭН-ши-а тро-кэн-ТЭ-ри-ка","definition_ru":"Наружный размер между большими вертелами бедренных костей; в лекции 30–31 см.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:external_conjugate","glossary":"pelvis","term_en":"external conjugate (Baudelocque)","term_ru":"наружная конъюгата","pronunciation_ru":"экс-ТЁР-нэл кон-джу-ГЭЙТ","definition_ru":"Наружный переднезадний размер таза; ориентир в лекции — 20–21 см.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]}]