арушением оттока секрета.","tags":["pathology","vulva","glands"],"related":["vulva:apocrine_glands","vulva:bartholin_abscess"]},{"id":"vulva:bartholin_abscess","glossary":"vulva","term_en":"Bartholin abscess","term_ru":"абсцесс бартолиновой железы","pronunciation_ru":"БАР-то-лин ЭБ-сэс","definition_ru":"Гнойное воспаление в области бартолиновой железы.","tags":["pathology","vulva","infection","glands"],"related":["vulva:apocrine_glands","vulva:bartholin_cyst","vulva:bartholin_glands","vulva:condylomata","vulva:genital_herpes","vulva:lesser_vestibular_glands","vulva:mucous_acini","vulva:sebaceous_glands","vulva:skene_glands"]},{"id":"vulva:vulvovaginitis","glossary":"vulva","term_en":"vulvovaginitis","term_ru":"вульвовагинит","pronunciation_ru":"ВАЛ-во-ва-джи-НАЙ-тис","definition_ru":"Воспалительный процесс, затрагивающий вульву и влагалище.","tags":["pathology","vulva","vagina","inflammation","infection"],"related":["cervix:cervicitis","cycle:whiff_test","vagina:amsel_criteria","vagina:trichomoniasis"]},{"id":"vulva:lichen_sclerosus","glossary":"vulva","term_en":"lichen sclerosus","term_ru":"склероатрофический лишай","pronunciation_ru":"ЛАЙ-кэн склэ-РОУ-сэс","definition_ru":"Хроническое заболевание кожи вульвы, перечисленное в лекции среди её патологий.","tags":["pathology","vulva","dermatology"],"related":["vagina:vulvovaginal_candidiasis","vulva:apocrine_glands"]},{"id":"vulva:vin","glossary":"vulva","term_en":"vulvar intraepithelial neoplasia (VIN)","term_ru":"вульварная интраэпителиальная неоплазия","pronunciation_ru":"ВАЛ-вэр ин-тра-э-пи-ТИ-ли-эл ни-о-ПЛЭЙ-жа","definition_ru":"Предраковое эпителиальное поражение вульвы; сокращение VIN используется в лекции.","tags":["pathology","vulva","oncology","neoplasia"],"related":["vagina:vain","vulva:superficial_inguinal_nodes","vulva:vulvar_carcinoma"]},{"id":"vulva:vulvar_carcinoma","glossary":"vulva","term_en":"vulvar carcinoma","term_ru":"рак вульвы","pronunciation_ru":"ВАЛ-вэр кар-си-НО-ма","definition_ru":"Злокачественная опухоль вульвы; лекция упоминает плоскоклеточный вариант и связь с ВПЧ или склероатрофическим лишаём.","tags":["pathology","vulva","oncology"],"related":["vulva:superficial_inguinal_nodes","vulva:vin"]},{"id":"vulva:condylomata","glossary":"vulva","term_en":"condylomata acuminata","term_ru":"остроконечные кондиломы","pronunciation_ru":"кон-ди-ло-МА-та э-кью-ми-НА-та","definition_ru":"Кондиломы, связанные в лекции с типами ВПЧ 6 и 11.","tags":["pathology","vulva","hpv","infection"],"related":["vulva:bartholin_abscess","vulva:genital_herpes"]},{"id":"vulva:genital_herpes","glossary":"vulva","term_en":"genital herpes","term_ru":"генитальный герпес","pronunciation_ru":"ДЖЭ-ни-тэл ХЁР-пиз","definition_ru":"Герпетическая инфекция наружных половых органов; лекция отдельно упоминает HSV-2.","tags":["pathology","vulva","infection","virus"],"related":["vulva:bartholin_abscess","vulva:condylomata"]},{"id":"vulva:imperforate_hymen","glossary":"vulva","term_en":"imperforate hymen","term_ru":"неперфорированная девственная плева","pronunciation_ru":"им-ПЁР-фо-рэй-тид ХАЙ-мэн","definition_ru":"Врожденное отсутствие отверстия в гимене; в лекции связано с возможным гематокольпосом.","tags":["pathology","vulva","congenital"],"related":["uterus:bicornuate_uterus","vulva:hematocolpos"]},{"id":"vulva:hematocolpos","glossary":"vulva","term_en":"hematocolpos","term_ru":"гематокольпос","pronunciation_ru":"хи-МА-тоу-КОЛ-пэс","definition_ru":"Скопление крови во влагалище, в частности при нарушении оттока менструальной крови.","tags":["pathology","vagina","vulva","congenital"],"related":["vagina:mrkh","vagina:transverse_vaginal_septum","vagina:vaginal_agenesis","vagina:vulvovaginal_candidiasis","vulva:hymen","vulva:imperforate_hymen","vulva:vaginal_introitus","vulva:vestibule"]}]