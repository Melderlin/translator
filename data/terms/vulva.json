[{"id":"vulva:vulva","glossary":"vulva","term_en":"vulva","term_ru":"вульва; наружные женские половые органы","pronunciation_ru":"ВАЛ-ва","definition_ru":"Совокупность наружных женских половых органов: лобок, большие и малые половые губы, клитор, преддверие и связанные структуры.","tags":["anatomy","vulva","external-genitalia"],"related":["vulva:labia_majora","vulva:labia_minora"]},{"id":"vulva:mons_pubis","glossary":"vulva","term_en":"mons pubis","term_ru":"лобок","pronunciation_ru":"МОНЗ ПЬЮ-бис","definition_ru":"Жировая подушка над лобковым симфизом.","tags":["anatomy","vulva","external-genitalia"],"related":["vulva:labia_majora","vulva:labia_minora"]},{"id":"vulva:labia_majora","glossary":"vulva","term_en":"labia majora","term_ru":"большие половые губы","pronunciation_ru":"ЛЭЙ-би-а мэ-ДЖОР-а","definition_ru":"Кожные складки наружных половых органов; в лекции указаны как гомолог мошонки.","tags":["anatomy","vulva","external-genitalia"],"related":["vulva:labia_minora","vulva:mons_pubis","vulva:vulva"]},{"id":"vulva:labia_minora","glossary":"vulva","term_en":"labia minora","term_ru":"малые половые губы","pronunciation_ru":"ЛЭЙ-би-а ми-НОР-а","definition_ru":"Внутренние складки вульвы; в лекции отмечены отсутствие волос и богатая сосудистая строма.","tags":["anatomy","vulva","external-genitalia","histology"],"related":["vulva:labia_majora","vulva:mons_pubis","vulva:vulva"]},{"id":"vulva:clitoris","glossary":"vulva","term_en":"clitoris","term_ru":"клитор","pronunciation_ru":"КЛИ-тэ-рис","definition_ru":"Чувствительный эректильный орган; выделяют головку, тело и ножки.","tags":["anatomy","vulva","sexual-function"],"related":["vulva:body_clitoris","vulva:crura_clitoris","vulva:glans_clitoris"]},{"id":"vulva:glans_clitoris","glossary":"vulva","term_en":"glans of the clitoris","term_ru":"головка клитора","pronunciation_ru":"ГЛЭНЗ ов зэ КЛИ-тэ-рис","definition_ru":"Дистальная часть клитора, указанная в лекции среди его анатомических частей.","tags":["anatomy","vulva","sexual-function"],"related":["vulva:body_clitoris","vulva:clitoris"]},{"id":"vulva:body_clitoris","glossary":"vulva","term_en":"body of the clitoris","term_ru":"тело клитора","pronunciation_ru":"БО-ди ов зэ КЛИ-тэ-рис","definition_ru":"Часть клитора между головкой и ножками.","tags":["anatomy","vulva","sexual-function"],"related":["vulva:clitoris","vulva:crura_clitoris","vulva:glans_clitoris"]},{"id":"vulva:crura_clitoris","glossary":"vulva","term_en":"crura of the clitoris","term_ru":"ножки клитора","pronunciation_ru":"КРУ-ра ов зэ КЛИ-тэ-рис","definition_ru":"Парные проксимальные части клитора.","tags":["anatomy","vulva","sexual-function"],"related":["vulva:body_clitoris","vulva:clitoris"]},{"id":"vulva:vestibule","glossary":"vulva","term_en":"vestibule of the vagina","term_ru":"преддверие влагалища","pronunciation_ru":"ВЭС-ти-бьюл ов зэ вэ-ДЖАЙ-на","definition_ru":"Пространство между малыми половыми губами, где открываются уретра, влагалище и железы преддверия.","tags":["anatomy","vulva","vagina"],"related":["vagina:vulvovaginal_candidiasis","vulva:hematocolpos"]},{"id":"vulva:urethra","glossary":"vulva","term_en":"urethra","term_ru":"уретра; мочеиспускательный канал","pronunciation_ru":"ю-РИ-тра","definition_ru":"Канал отведения мочи; наружное отверстие уретры открывается в преддверие влагалища.","tags":["anatomy","urinary","vulva"],"related":["pelvis:cystocele","vulva:external_urethral_orifice"]},{"id":"vulva:external_urethral_orifice","glossary":"vulva","term_en":"external urethral orifice","term_ru":"наружное отверстие уретры","pronunciation_ru":"экс-ТЁР-нэл ю-РИ-трэл ОР-и-фис","definition_ru":"Отверстие уретры в преддверии влагалища.","tags":["anatomy","urinary","vulva"],"related":["pelvis:cystocele","vulva:urethra"]},{"id":"vulva:vaginal_introitus","glossary":"vulva","term_en":"vaginal introitus","term_ru":"вход во влагалище","pronunciation_ru":"ВЭДЖ-и-нэл ин-ТРОЙ-тэс","definition_ru":"Отверстие, ведущее в полость влагалища.","tags":["anatomy","vulva","vagina"],"related":["vagina:vulvovaginal_candidiasis","vulva:hematocolpos"]},{"id":"vulva:hymen","glossary":"vulva","term_en":"hymen","term_ru":"девственная плева; гимен","pronunciation_ru":"ХАЙ-мэн","definition_ru":"Складка слизистой ткани у входа во влагалище; в лекции описан вариант неперфорированной плевы.","tags":["anatomy","vulva","vagina","pathology"],"related":["vagina:vulvovaginal_candidiasis","vulva:hematocolpos"]},{"id":"vulva:bartholin_glands","glossary":"vulva","term_en":"Bartholin’s (greater vestibular) glands","term_ru":"бартолиновы железы; большие железы преддверия","pronunciation_ru":"БАР-то-линз грЭЙ-тэр вэс-ТИ-бью-лэр глЭНДЗ","definition_ru":"Парные слизистые железы преддверия влагалища; отверстия находятся заднебоково примерно на позициях 4 и 8 часов.","tags":["anatomy","vulva","glands","histology"],"related":["vulva:apocrine_glands","vulva:bartholin_abscess"]},{"id":"vulva:skene_glands","glossary":"vulva","term_en":"Skene’s (paraurethral) glands","term_ru":"парауретральные железы Скина","pronunciation_ru":"СКИ-нз пэ-ра-ю-РИ-трэл глЭНДЗ","definition_ru":"Железы рядом с уретрой, перечисленные в лекции среди структур преддверия.","tags":["anatomy","vulva","glands"],"related":["vulva:apocrine_glands","vulva:bartholin_abscess"]},{"id":"vulva:lesser_vestibular_glands","glossary":"vulva","term_en":"lesser vestibular glands","term_ru":"малые железы преддверия","pronunciation_ru":"ЛЭ-сэр вэс-ТИ-бью-лэр глЭНДЗ","definition_ru":"Железы преддверия, перечисленные в анатомическом разделе лекции.","tags":["anatomy","vulva","glands"],"related":["vulva:apocrine_glands","vulva:bartholin_abscess"]},{"id":"vulva:vestibular_bulbs","glossary":"vulva","term_en":"vestibular bulbs","term_ru":"луковицы преддверия","pronunciation_ru":"вэс-ТИ-бью-лэр БАЛБЗ","definition_ru":"Парные образования эректильной ткани преддверия влагалища.","tags":["anatomy","vulva","erectile-tissue"],"related":["vagina:vulvovaginal_candidiasis","vulva:apocrine_glands"]},{"id":"vulva:perineum","glossary":"vulva","term_en":"perineum","term_ru":"промежность","pronunciation_ru":"пэ-ри-НИ-эм","definition_ru":"Ромбовидная область между бёдрами, включающая мочеполовой и анальный треугольники.","tags":["anatomy","pelvis","perineum"],"related":["cycle:pelvimetry","pelvis:perineal_body"]},{"id":"vulva:internal_pudendal_artery","glossary":"vulva","term_en":"internal pudendal artery","term_ru":"внутренняя половая артерия","pronunciation_ru":"ин-ТЁР-нэл пью-ДЭН-дэл АР-тэ-ри","definition_ru":"Артерия, отходящая от внутренней подвздошной артерии и кровоснабжающая наружные половые органы и промежность.","tags":["anatomy","vulva","blood-supply"],"related":["uterus:basal_arteries","vulva:external_pudendal_artery"]},{"id":"vulva:external_pudendal_artery","glossary":"vulva","term_en":"external pudendal artery","term_ru":"наружная половая артерия","pronunciation_ru":"экс-ТЁР-нэл пью-ДЭН-дэл АР-тэ-ри","definition_ru":"Артериальный источник наружных половых органов; в лекции указан как ветвь бедренной артерии.","tags":["anatomy","vulva","blood-supply"],"related":["uterus:basal_arteries","vulva:internal_pudendal_artery"]},{"id":"vulva:internal_iliac_artery","glossary":"vulva","term_en":"internal iliac artery","term_ru":"внутренняя подвздошная артерия","pronunciation_ru":"ин-ТЁР-нэл ИЛ-и-эк АР-тэ-ри","definition_ru":"Источник внутренней половой артерии и ряда артерий органов малого таза.","tags":["anatomy","blood-supply","pelvis"],"related":["cycle:pelvimetry","ovaries:ovarian_fossa"]},{"id":"vulva:femoral_artery","glossary":"vulva","term_en":"femoral artery","term_ru":"бедренная артерия","pronunciation_ru":"ФЭМ-эр-эл АР-тэ-ри","definition_ru":"Артерия бедра; в лекции названа источником наружной половой артерии.","tags":["anatomy","blood-supply"],"related":["uterus:basal_arteries","uterus:ovarian_artery"]},{"id":"vulva:vulvar_varicosities","glossary":"vulva","term_en":"vulvar varicosities","term_ru":"варикозное расширение вен вульвы","pronunciation_ru":"ВАЛ-вэр вэ-ри-КО-си-тиз","definition_ru":"Расширение вен вульвы; лекция отмечает его возможное развитие во время беременности.","tags":["pathology","vulva","veins","pregnancy"],"related":["cervix:cerclage","cervix:cervical_insufficiency"]},{"id":"vulva:hematoma","glossary":"vulva","term_en":"hematoma","term_ru":"гематома","pronunciation_ru":"хи-ма-ТО-ма","definition_ru":"Скопление крови в тканях; в лекции отмечено как возможное последствие травмы наружных половых органов.","tags":["pathology","vulva","trauma"],"related":["vagina:vulvovaginal_candidiasis","vulva:apocrine_glands"]},{"id":"vulva:pudendal_nerve","glossary":"vulva","term_en":"pudendal nerve","term_ru":"половой нерв","pronunciation_ru":"пью-ДЭН-дэл нёрв","definition_ru":"Нерв с корешковыми уровнями S2–S4, связанный с чувствительной и двигательной иннервацией промежности.","tags":["anatomy","vulva","innervation","perineum"],"related":["ovaries:ovarian_plexus","pelvis:perineal_body"]},{"id":"vulva:pudendal_block","glossary":"vulva","term_en":"pudendal block","term_ru":"пудендальная блокада; блокада полового нерва","pronunciation_ru":"пью-ДЭН-дэл блок","definition_ru":"Регионарная анестезия полового нерва, упомянутая в лекции для обезболивания в родах.","tags":["clinical","vulva","anesthesia","obstetrics"],"related":["cervix:cervical_insufficiency","cycle:pelvimetry"]},{"id":"vulva:superficial_inguinal_nodes","glossary":"vulva","term_en":"superficial inguinal lymph nodes","term_ru":"поверхностные паховые лимфатические узлы","pronunciation_ru":"сю-пэр-ФИ-шэл ИН-гви-нэл ЛИМФ НОУДЗ","definition_ru":"Регионарные лимфоузлы, важные при оценке распространения рака вульвы.","tags":["anatomy","vulva","lymphatic-drainage","oncology"],"related":["uterus:para_aortic_nodes","vulva:vin","vulva:vulvar_carcinoma"]},{"id":"vulva:keratinized_epithelium","glossary":"vulva","term_en":"keratinized stratified squamous epithelium","term_ru":"ороговевающий многослойный плоский эпителий","pronunciation_ru":"КЭ-ри-тэ-найзд СТРЭ-ти-файд скВЭЙ-мэс э-пи-ТИ-ли-эм","defini