[{"id":"vagina:vagina","glossary":"vagina","term_en":"vagina","term_ru":"влагалище","pronunciation_ru":"вэ-ДЖАЙ-на","definition_ru":"Фиброзно-мышечная трубка длиной примерно 7–9 см; участвует в половом акте, родовом канале и отведении менструальной крови.","tags":["anatomy","vagina","internal-genitalia"],"related":["cycle:vaginal_ph","cycle:whiff_test"]},{"id":"vagina:vaginal_fornices","glossary":"vagina","term_en":"vaginal fornices","term_ru":"своды влагалища","pronunciation_ru":"ВЭДЖ-и-нэл ФОР-ни-сиз","definition_ru":"Углубления вокруг влагалищной части шейки матки: передний, задний и два боковых свода.","tags":["anatomy","vagina","cervix"],"related":["cervix:cerclage","cervix:cervical_cancer"]},{"id":"vagina:posterior_fornix","glossary":"vagina","term_en":"posterior fornix","term_ru":"задний свод влагалища","pronunciation_ru":"пос-ТИ-ри-эр ФОР-никс","definition_ru":"Задний свод рядом с прямокишечно-маточным углублением; в лекции указан как доступ для кульдоцентеза.","tags":["anatomy","vagina","pelvis","clinical"],"related":["pelvis:cystocele","pelvis:enterocele"]},{"id":"vagina:pouch_douglas","glossary":"vagina","term_en":"pouch of Douglas (rectouterine pouch)","term_ru":"прямокишечно-маточное углубление; карман Дугласа","pronunciation_ru":"ПАУЧ ов ДАГ-лэс","definition_ru":"Брюшинное углубление между маткой и прямой кишкой.","tags":["anatomy","pelvis","uterus","vagina"],"related":["pelvis:cystocele","pelvis:enterocele","uterus:uterovaginal_plexus"]},{"id":"vagina:culdocentesis","glossary":"vagina","term_en":"culdocentesis","term_ru":"кульдоцентез","pronunciation_ru":"кал-до-сэн-ТЕЕ-сис","definition_ru":"Пункция прямокишечно-маточного углубления через задний свод влагалища; метод упомянут в лекции.","tags":["diagnostics","vagina","pelvis"],"related":["pelvis:cystocele","pelvis:enterocele","pelvis:vesicovaginal_fistula"]},{"id":"vagina:colpotomy","glossary":"vagina","term_en":"colpotomy","term_ru":"кольпотомия","pronunciation_ru":"кол-ПО-то-ми","definition_ru":"Хирургическое рассечение стенки влагалища; упомянуто при описании доступа через задний свод.","tags":["clinical","vagina","surgery"],"related":["cervix:cerclage","cycle:hysteroscopy"]},{"id":"vagina:vaginal_artery","glossary":"vagina","term_en":"vaginal artery","term_ru":"влагалищная артерия","pronunciation_ru":"вэ-ДЖАЙ-нэл АР-тэ-ри","definition_ru":"Источник кровоснабжения влагалища; также указаны ветви маточной и внутренняя половая артерия.","tags":["anatomy","vagina","blood-supply"],"related":["cycle:vaginal_ph","cycle:whiff_test"]},{"id":"vagina:nonkeratinized_epithelium","glossary":"vagina","term_en":"non-keratinized stratified squamous epithelium","term_ru":"неороговевающий многослойный плоский эпителий","pronunciation_ru":"нон-КЭ-ри-тэ-найзд СТРЭ-ти-файд скВЭЙ-мэс э-пи-ТИ-ли-эм","definition_ru":"Эпителий влагалища, богатый гликогеном и не содержащий собственных желез по лекции.","tags":["histology","vagina","epithelium"],"related":["cervix:cervical_ectopy","cervix:ectocervix"]},{"id":"vagina:lamina_propria","glossary":"vagina","term_en":"lamina propria","term_ru":"собственная пластинка слизистой оболочки","pronunciation_ru":"ЛЭ-ми-на ПРОУ-при-а","definition_ru":"Слой соединительной ткани под эпителием; в лекции отмечено богатое венозное сплетение.","tags":["histology","vagina","mucosa"],"related":["cycle:vaginal_ph","cycle:whiff_test"]},{"id":"vagina:venous_plexus","glossary":"vagina","term_en":"venous plexus","term_ru":"венозное сплетение","pronunciation_ru":"ВИ-нэс ПЛЭК-сэс","definition_ru":"Сеть венозных сосудов, находящаяся в собственной пластинке стенки влагалища.","tags":["anatomy","histology","vagina","veins"],"related":["cycle:vaginal_ph","cycle:whiff_test"]},{"id":"vagina:muscularis","glossary":"vagina","term_en":"muscularis","term_ru":"мышечная оболочка","pronunciation_ru":"мас-кью-ЛЭ-рис","definition_ru":"Мышечный слой влагалища с внутренним циркулярным и наружным продольным слоями.","tags":["histology","vagina","muscle"],"related":["cycle:vaginal_ph","cycle:whiff_test"]},{"id":"vagina:adventitia","glossary":"vagina","term_en":"adventitia","term_ru":"адвентиция","pronunciation_ru":"эд-вэн-ТИ-ша","definition_ru":"Наружный соединительнотканный слой стенки влагалища.","tags":["histology","vagina"],"related":["cycle:vaginal_ph","cycle:whiff_test"]},{"id":"vagina:lactobacillus","glossary":"vagina","term_en":"Lactobacillus","term_ru":"лактобациллы","pronunciation_ru":"ЛЭК-тоу-бэ-СИ-лэс","definition_ru":"Бактерии, поддерживающие кислую среду влагалища за счёт превращения гликогена в молочную кислоту.","tags":["physiology","vagina","microbiome"],"related":["cycle:vaginal_ph","vagina:bacterial_vaginosis"]},{"id":"vagina:doderlein_bacilli","glossary":"vagina","term_en":"Döderlein bacilli","term_ru":"палочки Дёдерлейна","pronunciation_ru":"ДЁ-дэр-лайн бэ-САЙ-лай","definition_ru":"Традиционное обозначение лактобацилл влагалищной микробиоты в лекции.","tags":["physiology","vagina","microbiome"],"related":["cycle:vaginal_ph","vagina:bacterial_vaginosis"]},{"id":"vagina:glycogen","glossary":"vagina","term_en":"glycogen","term_ru":"гликоген","pronunciation_ru":"ГЛАЙ-ко-джэн","definition_ru":"Углеводный запас в эпителии влагалища; лактобациллы преобразуют его в молочную кислоту.","tags":["physiology","histology","vagina","metabolism"],"related":["cycle:vaginal_ph","cycle:whiff_test"]},{"id":"vagina:lactic_acid","glossary":"vagina","term_en":"lactic acid","term_ru":"молочная кислота","pronunciation_ru":"ЛЭК-тик ЭС-ид","definition_ru":"Кислота, образующаяся при преобразовании гликогена лактобациллами и поддерживающая кислую влагалищную среду.","tags":["physiology","vagina","microbiome"],"related":["cycle:vaginal_ph","vagina:bacterial_vaginosis"]},{"id":"vagina:bacterial_vaginosis","glossary":"vagina","term_en":"bacterial vaginosis","term_ru":"бактериальный вагиноз","pronunciation_ru":"бэк-ТИ-ри-эл вэ-джи-НОУ-сис","definition_ru":"Нарушение вагинальной микробиоты; в лекции упомянуты Gardnerella, критерии Амселя и ключевые клетки.","tags":["pathology","vagina","infection","microbiome"],"related":["cycle:vaginal_ph","cycle:whiff_test","vagina:doderlein_bacilli","vagina:lactic_acid","vagina:lactobacillus"]},{"id":"vagina:gardnerella","glossary":"vagina","term_en":"Gardnerella vaginalis","term_ru":"гарднерелла вагиналис","pronunciation_ru":"гард-нэ-РЭЛ-а вэ-джи-НЭЙ-лис","definition_ru":"Микроорганизм, указанный в лекции в связи с бактериальным вагинозом.","tags":["pathology","vagina","microbiology"],"related":["cycle:vaginal_ph","vagina:trichomonas_vaginalis"]},{"id":"vagina:amsel_criteria","glossary":"vagina","term_en":"Amsel criteria","term_ru":"критерии Амселя","pronunciation_ru":"АМ-сэл край-ТИ-ри-а","definition_ru":"Клинические критерии, упомянутые в лекции при описании бактериального вагиноза.","tags":["diagnostics","vagina","infection"],"related":["cycle:whiff_test","vulva:vulvovaginitis"]},{"id":"vagina:clue_cells","glossary":"vagina","term_en":"clue cells","term_ru":"ключевые клетки","pronunciation_ru":"КЛУ селз","definition_ru":"Клетки, упомянутые в лекции среди диагностических признаков бактериального вагиноза.","tags":["diagnostics","vagina","histology"],"related":["cycle:vaginal_ph","cycle:whiff_test"]},{"id":"vagina:vulvovaginal_candidiasis","glossary":"vagina","term_en":"vulvovaginal candidiasis","term_ru":"вульвовагинальный кандидоз","pronunciation_ru":"ВАЛ-во-ва-ДЖАЙ-нэл кэн-ди-ДАЙ-э-сис","definition_ru":"Грибковая инфекция вульвы и влагалища, перечисленная в лекции среди заболеваний влагалища.","tags":["pathology","vagina","vulva","fungal-infection"],"related":["vulva:hair_follicles","vulva:hematocolpos","vulva:hematoma","vulva:hymen","vulva:lichen_sclerosus","vulva:vaginal_introitus","vulva:vestibular_bulbs","vulva:vestibule"]},{"id":"vagina:trichomoniasis","glossary":"vagina","term_en":"trichomoniasis","term_ru":"трихомониаз","pronunciation_ru":"три-ко-мо-НАЙ-э-сис","definition_ru":"Инфекция, вызванная Trichomonas vaginalis; перечислена в разделе патологии влагалища.","tags":["pathology","vagina","infection"],"related":["cycle:whiff_test","vulva:vulvovaginitis"]},{"id":"vagina:trichomonas_vaginalis","glossary":"vagina","term_en":"Trichomonas vaginalis","term_ru":"трихомонада влагалищная","pronunciation_ru":"три-КОУ-мо-нэс вэ-джи-НЭЙ-лис","definition_ru":"Возбудитель трихомониаза, указанный в лекции.","tags":["pathology","vagina","microbiology"],"related":["cycle:vaginal_ph","vagina:gardnerella"]},{"id":"vagina:atrophic_vaginitis","glossary":"vagina","term_en":"atrophic vaginitis","term_ru":"атрофический вагинит","pronunciation_ru":"э-ТРОУ-фик вэ-джи-НАЙ-тис","definition_ru":"Состояние, упомянутое в лекции рядом с генитоуринарным синдромом менопаузы и снижением эстрогенов.","tags":["pathology","vagina","menopause","hypoestrogenism"],"related":["cycle:vaginal_ph","vagina:genitourinary_menopause"]},{"id":"vagina:genitourinary_menopause","glossary":"vagina","term_en":"genitourinary syndrome of menopause","term_ru":"генитоуринарный синдром менопаузы","pronunciation_ru":"джэ-ни-тоу-Ю-ри-нэр-и СИН-дроум ов МЭ-но-поз","definition_ru":"Комплекс урогенитальных проявлений, связанный с менопаузой; упомянут в лекции рядом с атрофическим вагинитом.","tags":["pathology","vagina","menopause","hypoestrogenism"],"related":["cycle:vaginal_ph","vagina:atrophic_vaginitis"]},{"id":"vagina:vaginal_agenesis","glossary":"vagina","term_en":"vaginal agenesis","term_ru":"аплазия влагалища","pronunciation_ru":"ВЭДЖ-и-нэл э-ДЖЭН-э-сис","definition_ru":"Врожденное отсутствие или недоразвитие влагалища; в лекции приведён синдром MRKH.","tags":["pathology","vagina","congenital"],"related":["vagina:mrkh","vulva:hematocolpos"]},{"id":"vagina:mrkh","glossary":"vagina","term_en":"Mayer–Rokitansky–Küster–Hauser syndrome (MRKH)","term_ru":"синдром Майера–Рокитанского–Кюстнера–Хаузера","pronunciation_ru":"МАЙ-эр ро-ки-ТЭН-ски КЬЮ-стэр ХАУ-зэр СИН-дроум","definition_ru":"Синдром, приведённый в лекции среди причин врождённой аплазии влагалища.","tags":["pathology","vagina","congenital"],"related":["vagina:transverse_vaginal_septum","vagina:vaginal_agenesis","vulva:hematocolpos"]},{"id":"vagina:transverse_vaginal_septum","glossary":"vagina","term_en":"transverse vaginal septum","term_ru":"поперечная перегородка влагалища","pronunciation_ru":"транс-ВЁРС вэ-ДЖАЙ-нэл СЭП-тэм","definition_ru":"Врожденная перегородка в полости влагалища, перечисленная в лекции.","tags":["pathology","vagina","congenital"],"related":["vagina:mrkh","vulva:hematocolpos"]},{"id":"vagina:vaginal_cancer","glossary":"vagina","term_en":"vaginal cancer","term_ru":"рак влагалища","pronunciation_ru":"вэ-ДЖАЙ-нэл КЭН-сэр","definition_ru":"Злокачественное новообразование влагалища, названное в лекции среди патологий.","tags":["pathology","vagina","oncology"],"related":["cervix:cervical_cancer","vagina:vain"]},{"id":"vagina:vain","glossary":"vagina","term_en":"vaginal intraepithelial neoplasia (VAIN)","term_ru":"вагинальная интраэпителиальная неоплазия","pronunciation_ru":"вэ-ДЖАЙ-нэл ин-тра-э-пи-ТИ-ли-эл ни-о-ПЛЭЙ-жа","definition_ru":"Интраэпителиальное неопластическое поражение влагалища; сокращение VAIN приведено в лекции.","tags":["pathology","vagina","oncology","neoplasia"],"related":["vagina:vaginal_cancer","vulva:vin"]}]