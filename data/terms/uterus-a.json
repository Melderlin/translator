[{"id":"uterus:uterus","glossary":"uterus","term_en":"uterus","term_ru":"матка","pronunciation_ru":"Ю-тэ-рэс","definition_ru":"Грушевидный полый мышечный орган; размеры нерожавшей женщины в лекции — около 7–8 см длиной, 4–5 см шириной и 2–3 см толщиной.","tags":["anatomy","uterus","internal-genitalia"],"related":["cervix:cervix","cycle:endometrial_biopsy"]},{"id":"uterus:fundus","glossary":"uterus","term_en":"fundus of the uterus","term_ru":"дно матки","pronunciation_ru":"ФАН-дэс ов зэ Ю-тэ-рэс","definition_ru":"Верхняя часть матки над устьями маточных труб.","tags":["anatomy","uterus"],"related":["cervix:cervix","cycle:endometrial_biopsy"]},{"id":"uterus:corpus","glossary":"uterus","term_en":"corpus (body) of the uterus","term_ru":"тело матки","pronunciation_ru":"КОР-пэс (БО-ди) ов зэ Ю-тэ-рэс","definition_ru":"Основная часть матки между дном и перешейком.","tags":["anatomy","uterus"],"related":["cervix:cervix","cycle:endometrial_biopsy"]},{"id":"uterus:isthmus","glossary":"uterus","term_en":"isthmus of the uterus","term_ru":"перешеек матки","pronunciation_ru":"ИС-мэс ов зэ Ю-тэ-рэс","definition_ru":"Узкая область между телом и шейкой матки; при беременности участвует в формировании нижнего сегмента.","tags":["anatomy","uterus","pregnancy"],"related":["cycle:uterine_quiescence","uterus:decidualization"]},{"id":"uterus:lower_segment","glossary":"uterus","term_en":"lower uterine segment","term_ru":"нижний сегмент матки","pronunciation_ru":"ЛОУ-эр Ю-тэ-рин СЭГ-мэнт","definition_ru":"Часть матки, формирующаяся в области перешейка во время беременности.","tags":["anatomy","uterus","pregnancy","obstetrics"],"related":["cervix:cervical_insufficiency","cycle:uterine_quiescence","pelvis:uterine_rupture"]},{"id":"uterus:cervix","glossary":"uterus","term_en":"cervix of the uterus","term_ru":"шейка матки","pronunciation_ru":"СЁР-вик ов зэ Ю-тэ-рэс","definition_ru":"Нижняя часть матки; имеет надвлагалищную и влагалищную части, наружный и внутренний зевы.","tags":["anatomy","uterus","cervix"],"related":["cervix:cervix","cervix:nabothian_cysts","uterus:external_os","uterus:internal_os"]},{"id":"uterus:uterine_cavity","glossary":"uterus","term_en":"uterine cavity","term_ru":"полость матки","pronunciation_ru":"Ю-тэ-рин КЭ-вэ-ти","definition_ru":"Внутренняя полость матки, описанная в лекции как треугольная.","tags":["anatomy","uterus","endometrium"],"related":["cycle:endometrial_biopsy","uterus:adenomyosis"]},{"id":"uterus:internal_os","glossary":"uterus","term_en":"internal os","term_ru":"внутренний зев матки","pronunciation_ru":"ин-ТЁР-нэл ос","definition_ru":"Отверстие канала шейки матки, сообщающееся с полостью матки.","tags":["anatomy","uterus","cervix"],"related":["cervix:cervix","uterus:cervix"]},{"id":"uterus:external_os","glossary":"uterus","term_en":"external os","term_ru":"наружный зев матки","pronunciation_ru":"экс-ТЁР-нэл ос","definition_ru":"Отверстие шейки матки, обращённое во влагалище.","tags":["anatomy","uterus","cervix"],"related":["cervix:cervix","uterus:cervix"]},{"id":"uterus:anteversion","glossary":"uterus","term_en":"anteversion","term_ru":"антеверзия матки","pronunciation_ru":"эн-ти-ВЁР-жэн","definition_ru":"Положение матки с наклоном вперёд относительно влагалища; в лекции относится к нормальному варианту.","tags":["anatomy","uterus","position"],"related":["uterus:anteflexion","uterus:retroflexion","uterus:retroversion"]},{"id":"uterus:anteflexion","glossary":"uterus","term_en":"anteflexion","term_ru":"антефлексия матки","pronunciation_ru":"эн-ти-ФЛЭК-шэн","definition_ru":"Изгиб тела матки вперёд относительно шейки; в лекции указан как нормальный вариант.","tags":["anatomy","uterus","position"],"related":["uterus:anteversion","uterus:retroflexion","uterus:retroversion"]},{"id":"uterus:retroversion","glossary":"uterus","term_en":"retroversion","term_ru":"ретроверзия матки","pronunciation_ru":"рэ-троу-ВЁР-жэн","definition_ru":"Вариант положения матки с отклонением назад, упомянутый в лекции.","tags":["anatomy","uterus","position"],"related":["uterus:anteflexion","uterus:anteversion"]},{"id":"uterus:retroflexion","glossary":"uterus","term_en":"retroflexion","term_ru":"ретрофлексия матки","pronunciation_ru":"рэ-троу-ФЛЭК-шэн","definition_ru":"Вариант изгиба матки назад, упомянутый в лекции.","tags":["anatomy","uterus","position"],"related":["uterus:anteflexion","uterus:anteversion"]},{"id":"uterus:round_ligament","glossary":"uterus","term_en":"round ligament of the uterus","term_ru":"круглая связка матки","pronunciation_ru":"РАУНД ЛИ-гэмэнт ов зэ Ю-тэ-рэс","definition_ru":"Связка из группы подвешивающего аппарата матки.","tags":["anatomy","uterus","ligaments"],"related":["uterus:broad_ligament","uterus:cardinal_ligament"]},{"id":"uterus:broad_ligament","glossary":"uterus","term_en":"broad ligament of the uterus","term_ru":"широкая связка матки","pronunciation_ru":"БРОД ЛИ-гэмэнт ов зэ Ю-тэ-рэс","definition_ru":"Дупликатура брюшины, перечисленная в лекции в составе подвешивающего аппарата матки.","tags":["anatomy","uterus","ligaments"],"related":["tubes:mesosalpinx","uterus:cardinal_ligament","uterus:infundibulopelvic_ligament","uterus:round_ligament"]},{"id":"uterus:utero_ovarian_ligament","glossary":"uterus","term_en":"utero-ovarian ligament","term_ru":"собственная связка яичника","pronunciation_ru":"Ю-тэ-роу-оу-ВЭ-ри-эн ЛИ-гэмэнт","definition_ru":"Связка между маткой и яичником, отнесённая в лекции к подвешивающему аппарату.","tags":["anatomy","uterus","ovary","ligaments"],"related":["cycle:menstrual_cycle","ovaries:mesovarium","uterus:infundibulopelvic_ligament"]},{"id":"uterus:infundibulopelvic_ligament","glossary":"uterus","term_en":"infundibulopelvic (suspensory) ligament","term_ru":"воронко-тазовая, или подвешивающая, связка яичника","pronunciation_ru":"ин-фан-ДИБ-ю-лоу-ПЭЛ-вик ЛИ-гэмэнт","definition_ru":"Связка яичника со стенкой таза; в ней проходят сосуды яичника.","tags":["anatomy","uterus","ovary","ligaments"],"related":["cycle:menstrual_cycle","cycle:tvus","ovaries:mesovarium","uterus:broad_ligament","uterus:utero_ovarian_ligament"]},{"id":"uterus:cardinal_ligament","glossary":"uterus","term_en":"cardinal (Mackenrodt’s) ligament","term_ru":"кардинальная связка матки","pronunciation_ru":"КАР-ди-нэл МЭК-эн-роутс ЛИ-гэмэнт","definition_ru":"Связка фиксирующего аппарата матки, указанная в лекции.","tags":["anatomy","uterus","ligaments","pelvic-floor"],"related":["pelvis:uterine_prolapse","uterus:broad_ligament","uterus:round_ligament","uterus:uterosacral_ligament"]},{"id":"uterus:uterosacral_ligament","glossary":"uterus","term_en":"uterosacral ligament","term_ru":"крестцово-маточная связка","pronunciation_ru":"Ю-тэ-роу-СЭЙ-крэл ЛИ-гэмэнт","definition_ru":"Связка фиксирующего аппарата матки, направляющаяся к крестцу.","tags":["anatomy","uterus","ligaments","pelvic-floor"],"related":["pelvis:uterine_prolapse","uterus:cardinal_ligament"]},{"id":"uterus:vesicouterine_pouch","glossary":"uterus","term_en":"vesicouterine pouch","term_ru":"пузырно-маточное углубление","pronunciation_ru":"вэ-зи-коу-Ю-тэ-рин ПАУЧ","definition_ru":"Брюшинное углубление между мочевым пузырём и маткой.","tags":["anatomy","uterus","peritoneum"],"related":["cervix:cervix","cycle:endometrial_biopsy"]},{"id":"uterus:uterine_artery","glossary":"uterus","term_en":"uterine artery","term_ru":"маточная артерия","pronunciation_ru":"Ю-тэ-рин АР-тэ-ри","definition_ru":"Артерия матки; проходит над мочеточником, что важно учитывать при гистерэктомии.","tags":["anatomy","uterus","blood-supply","surgery"],"related":["cycle:hysteroscopy","uterus:basal_arteries","uterus:ureter"]},{"id":"uterus:ureter","glossary":"uterus","term_en":"ureter","term_ru":"мочеточник","pronunciation_ru":"ю-РИ-тэр","definition_ru":"Орган, проводящий мочу из почки в мочевой пузырь; маточная артерия пересекает его сверху.","tags":["anatomy","urinary","uterus","surgery"],"related":["cycle:hysteroscopy","uterus:uterine_artery"]},{"id":"uterus:ovarian_artery","glossary":"uterus","term_en":"ovarian artery","term_ru":"яичниковая артерия","pronunciation_ru":"оу-ВЭ-ри-эн АР-тэ-ри","definition_ru":"Отходит от брюшной аорты и анастомозирует с маточной артерией.","tags":["anatomy","ovary","uterus","blood-supply"],"related":["cycle:menstrual_cycle","cycle:tvus","vulva:femoral_artery"]},{"id":"uterus:spiral_arteries","glossary":"uterus","term_en":"spiral arteries","term_ru":"спиральные артерии","pronunciation_ru":"СПАЙ-рэл АР-тэ-риз","definition_ru":"Кровоснабжают функциональный слой эндометрия и участвуют в менструальных изменениях.","tags":["anatomy","uterus","endometrium","blood-supply","menstrual-cycle"],"related":["uterus:adenomyosis","uterus:basal_arteries"]},{"id":"uterus:basal_arteries","glossary":"uterus","term_en":"basal arteries","term_ru":"базальные артерии","pronunciation_ru":"БЭЙ-сэл АР-тэ-риз","definition_ru":"Снабжают кровью базальный слой эндометрия согласно лекции.","tags":["anatomy","uterus","endometrium","blood-supply"],"related":["cycle:endometrial_biopsy","uterus:spiral_arteries","uterus:uterine_artery","vulva:external_pudendal_artery","vulva:femoral_artery","vulva:internal_pudendal_artery"]},{"id":"uterus:para_aortic_nodes","glossary":"uterus","term_en":"para-aortic lymph nodes","term_ru":"парааортальные лимфатические узлы","pronunciation_ru":"ПЭ-ра э-ОР-тик ЛИМФ НОУДЗ","definition_ru":"Узлы, к которым, согласно лекции, оттекает лимфа от дна матки и яичников.","tags":["anatomy","uterus","ovary","lymphatic-drainage","oncology"],"related":["cycle:endometrial_biopsy","cycle:menstrual_cycle","ovaries:brca","ovaries:krukenberg_tumour","ovaries:ovarian_tumours","vulva:superficial_inguinal_nodes"]},{"id":"uterus:uterovaginal_plexus","glossary":"uterus","term_en":"uterovaginal (Frankenhäuser) plexus","term_ru":"маточно-влагалищное сплетение; сплетение Франкенгейзера","pronunciation_ru":"Ю-тэ-роу-вэ-ДЖАЙ-нэл ФРЭН-кэн-хой-зэр ПЛЭК-сэс","definition_ru":"Нервное сплетение органов малого таза, участвующее в иннервации матки и влагалища.","tags":["anatomy","uterus","vagina","innervation"],"related":["cervix:cervix","vagina:pouch_douglas"]},{"id":"uterus:endometrium","glossary":"uterus","term_en":"endometrium","term_ru":"эндометрий","pronunciation_ru":"эн-до-МИ-три-эм","definition_ru":"Слизистая оболочка матки с функциональным и базальным слоями; претерпевает циклические изменения.","tags":["anatomy","histology","uterus","endometrium","menstrual-cycle"],"related":["uterus:adenomyosis","uterus:basal_layer"]},{"id":"uterus:functional_layer","glossary":"uterus","term_en":"functional layer (stratum functionale)","term_ru":"функциональный слой эндометрия","pronunciation_ru":"ФАНК-шэ-нэл ЛЭЙ-эр","definition_ru":"Верхние две трети эндометрия по лекции; отторгаются при менструации.","tags":["histology","uterus","endometrium","menstrual-cycle"],"related":["uterus:adenomyosis","uterus:basal_layer"]}]