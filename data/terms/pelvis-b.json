[{"id":"pelvis:michaelis_rhomboid","glossary":"pelvis","term_en":"Michaelis rhomboid","term_ru":"ромб Михаэлиса","pronunciation_ru":"МАЙ-кэ-лис РОМ-бойд","definition_ru":"Клинический ориентир для оценки формы таза.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:solovyov_index","glossary":"pelvis","term_en":"Solovyov index","term_ru":"индекс Соловьёва","pronunciation_ru":"со-ЛО-вьёв ИН-декс","definition_ru":"В лекции описан как окружность запястья, делённая на 10, для приблизительной оценки толщины костей.","tags":["anatomy","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:gynecoid_pelvis","glossary":"pelvis","term_en":"gynecoid pelvis","term_ru":"гинекоидный таз","pronunciation_ru":"ДЖАЙ-ни-койд ПЭЛ-вис","definition_ru":"Один из четырёх типов таза в классификации Caldwell–Moloy.","tags":["anatomy","pelvis","obstetrics","pelvic-types"],"related":["pelvis:android_pelvis","pelvis:anthropoid_pelvis"]},{"id":"pelvis:android_pelvis","glossary":"pelvis","term_en":"android pelvis","term_ru":"андроидный таз","pronunciation_ru":"ЭН-дройд ПЭЛ-вис","definition_ru":"Тип таза в классификации Caldwell–Moloy.","tags":["anatomy","pelvis","obstetrics","pelvic-types"],"related":["cycle:pelvimetry","pelvis:anthropoid_pelvis","pelvis:flat_pelvis","pelvis:greater_pelvis","pelvis:gynecoid_pelvis","pelvis:linea_terminalis","pelvis:pelvic_cavity","pelvis:pelvis","pelvis:platypelloid_pelvis","pelvis:sacral_promontory"]},{"id":"pelvis:anthropoid_pelvis","glossary":"pelvis","term_en":"anthropoid pelvis","term_ru":"антропоидный таз","pronunciation_ru":"ЭН-тро-пойд ПЭЛ-вис","definition_ru":"Тип таза в классификации Caldwell–Moloy.","tags":["anatomy","pelvis","obstetrics","pelvic-types"],"related":["pelvis:android_pelvis","pelvis:gynecoid_pelvis","pelvis:platypelloid_pelvis"]},{"id":"pelvis:platypelloid_pelvis","glossary":"pelvis","term_en":"platypelloid pelvis","term_ru":"платипеллоидный таз","pronunciation_ru":"плэ-ти-ПЭЛ-ойд ПЭЛ-вис","definition_ru":"Тип таза в классификации Caldwell–Moloy.","tags":["anatomy","pelvis","obstetrics","pelvic-types"],"related":["pelvis:android_pelvis","pelvis:anthropoid_pelvis"]},{"id":"pelvis:contracted_pelvis","glossary":"pelvis","term_en":"anatomically contracted pelvis","term_ru":"анатомически узкий таз","pronunciation_ru":"э-нэ-ТО-ми-кли кон-ТРЭК-тид ПЭЛ-вис","definition_ru":"Таз с уменьшенными размерами; лекция перечисляет поперечно-суженный, плоский и общеравномерно-суженный варианты.","tags":["pathology","pelvis","obstetrics","pelvimetry"],"related":["pelvis:anteroposterior_outlet","pelvis:conjugata_vera"]},{"id":"pelvis:flat_pelvis","glossary":"pelvis","term_en":"flat pelvis","term_ru":"плоский таз","pronunciation_ru":"ФЛЭТ ПЭЛ-вис","definition_ru":"Вариант анатомически узкого таза; в лекции названы простой плоский и плоскорахитический варианты.","tags":["pathology","pelvis","obstetrics"],"related":["cycle:pelvimetry","pelvis:android_pelvis"]},{"id":"pelvis:rickets","glossary":"pelvis","term_en":"rickets","term_ru":"рахит","pronunciation_ru":"РИ-киц","definition_ru":"Одно из названных в лекции состояний, способных быть причиной деформации таза.","tags":["pathology","bone","pelvis"],"related":["pelvis:acetabulum","pelvis:coccyx"]},{"id":"pelvis:cephalopelvic_disproportion","glossary":"pelvis","term_en":"cephalopelvic disproportion","term_ru":"несоответствие размеров таза и головки плода","pronunciation_ru":"сэ-фэ-ло-ПЭЛ-вик дис-прэ-пОР-шэн","definition_ru":"Несоответствие между размерами таза матери и головки плода; лекция связывает его с затруднёнными родами и осложнениями.","tags":["pathology","pelvis","obstetrics","labor"],"related":["cycle:pelvimetry","pelvis:obstetric_perineal_tear","pelvis:obstructed_labor"]},{"id":"pelvis:obstructed_labor","glossary":"pelvis","term_en":"obstructed labor","term_ru":"затруднённые роды","pronunciation_ru":"об-СТРАК-тид ЛЭЙ-бэр","definition_ru":"Осложнённые роды, при которых продвижение плода затруднено; возможное следствие узкого таза.","tags":["pathology","obstetrics","labor"],"related":["pelvis:cephalopelvic_disproportion","pelvis:obstetric_perineal_tear"]},{"id":"pelvis:uterine_rupture","glossary":"pelvis","term_en":"uterine rupture","term_ru":"разрыв матки","pronunciation_ru":"Ю-тэ-рин РАП-чер","definition_ru":"Тяжёлое акушерское осложнение, указанное среди возможных последствий клинически узкого таза.","tags":["pathology","obstetrics","uterus"],"related":["cervix:cervical_insufficiency","uterus:lower_segment"]},{"id":"pelvis:vesicovaginal_fistula","glossary":"pelvis","term_en":"vesicovaginal fistula","term_ru":"пузырно-влагалищный свищ","pronunciation_ru":"вэ-зи-ко-ва-ДЖАЙ-нэл ФИС-чу-ла","definition_ru":"Патологическое сообщение между мочевым пузырём и влагалищем; в лекции связано с осложнёнными родами.","tags":["pathology","pelvis","vagina","urinary"],"related":["pelvis:cystocele","vagina:culdocentesis"]},{"id":"pelvis:pelvic_diaphragm","glossary":"pelvis","term_en":"pelvic diaphragm","term_ru":"диафрагма таза","pronunciation_ru":"ПЭЛ-вик ДАЙ-э-фрэм","definition_ru":"Мышечный комплекс тазового дна, включающий levator ani и coccygeus.","tags":["anatomy","pelvis","pelvic-floor"],"related":["pelvis:coccygeus","pelvis:cystocele"]},{"id":"pelvis:levator_ani","glossary":"pelvis","term_en":"levator ani","term_ru":"мышца, поднимающая задний проход","pronunciation_ru":"ли-ВЭЙ-тэр ЭЙ-най","definition_ru":"Мышца тазового дна; её части — puborectalis, pubococcygeus и iliococcygeus.","tags":["anatomy","pelvis","pelvic-floor","muscle"],"related":["pelvis:coccygeus","pelvis:iliococcygeus"]},{"id":"pelvis:puborectalis","glossary":"pelvis","term_en":"puborectalis","term_ru":"лобково-прямокишечная мышца","pronunciation_ru":"ПЬЮ-бо-рек-ТЭЙ-лис","definition_ru":"Часть комплекса levator ani.","tags":["anatomy","pelvis","pelvic-floor","muscle"],"related":["pelvis:coccygeus","pelvis:iliococcygeus"]},{"id":"pelvis:pubococcygeus","glossary":"pelvis","term_en":"pubococcygeus","term_ru":"лобково-копчиковая мышца","pronunciation_ru":"ПЬЮ-бо-кок-СИ-джи-эс","definition_ru":"Часть комплекса levator ani.","tags":["anatomy","pelvis","pelvic-floor","muscle"],"related":["pelvis:coccygeus","pelvis:iliococcygeus"]},{"id":"pelvis:iliococcygeus","glossary":"pelvis","term_en":"iliococcygeus","term_ru":"подвздошно-копчиковая мышца","pronunciation_ru":"ИЛ-и-о-кок-СИ-джи-эс","definition_ru":"Часть комплекса levator ani.","tags":["anatomy","pelvis","pelvic-floor","muscle"],"related":["pelvis:coccygeus","pelvis:levator_ani","pelvis:pubococcygeus","pelvis:puborectalis"]},{"id":"pelvis:coccygeus","glossary":"pelvis","term_en":"coccygeus muscle","term_ru":"копчиковая мышца","pronunciation_ru":"кок-СИ-джи-эс МАС-эл","definition_ru":"Мышца, вместе с levator ani образующая диафрагму таза по лекции.","tags":["anatomy","pelvis","pelvic-floor","muscle"],"related":["pelvis:iliococcygeus","pelvis:levator_ani","pelvis:pelvic_diaphragm","pelvis:pelvic_organ_prolapse","pelvis:perineal_body","pelvis:pubococcygeus","pelvis:puborectalis","pelvis:urogenital_diaphragm"]},{"id":"pelvis:urogenital_diaphragm","glossary":"pelvis","term_en":"urogenital diaphragm","term_ru":"мочеполовая диафрагма","pronunciation_ru":"ю-ро-ДЖЭ-ни-тэл ДАЙ-э-фрэм","definition_ru":"Область мышечно-фасциальной поддержки; в лекции названы глубокая поперечная мышца промежности и наружный сфинктер уретры.","tags":["anatomy","pelvis","pelvic-floor"],"related":["pelvis:coccygeus","pelvis:cystocele"]},{"id":"pelvis:external_urethral_sphincter","glossary":"pelvis","term_en":"external urethral sphincter","term_ru":"наружный сфинктер уретры","pronunciation_ru":"экс-ТЁР-нэл ю-РИ-трэл СФИНК-тэр","definition_ru":"Сфинктер, участвующий в удержании мочи.","tags":["anatomy","pelvis","pelvic-floor","urinary"],"related":["pelvis:cystocele","pelvis:stress_urinary_incontinence"]},{"id":"pelvis:perineal_body","glossary":"pelvis","term_en":"perineal body","term_ru":"сухожильный центр промежности","pronunciation_ru":"пэ-ри-НИ-эл БО-ди","definition_ru":"Центральная фибромышечная структура промежности, к которой прикрепляются мышцы тазового дна.","tags":["anatomy","pelvis","perineum","pelvic-floor"],"related":["pelvis:coccygeus","vulva:perineum","vulva:pudendal_nerve"]},{"id":"pelvis:pelvic_organ_prolapse","glossary":"pelvis","term_en":"pelvic organ prolapse (POP)","term_ru":"пролапс тазовых органов","pronunciation_ru":"ПЭЛ-вик ОР-гэн ПРО-лэпс","definition_ru":"Опущение тазовых органов; в лекции перечислены cystocele, rectocele, enterocele и uterine prolapse.","tags":["pathology","pelvis","pelvic-floor"],"related":["pelvis:coccygeus","pelvis:cystocele"]},{"id":"pelvis:cystocele","glossary":"pelvis","term_en":"cystocele","term_ru":"цистоцеле","pronunciation_ru":"СИС-то-сил","definition_ru":"Пролапс передней стенки влагалища с вовлечением мочевого пузыря.","tags":["pathology","pelvis","vagina","urinary","pelvic-floor"],"related":["pelvis:enterocele","pelvis:external_urethral_sphincter","pelvis:pelvic_diaphragm","pelvis:pelvic_organ_prolapse","pelvis:rectocele","pelvis:stress_urinary_incontinence","pelvis:urogenital_diaphragm","pelvis:vesicovaginal_fistula","vagina:culdocentesis","vagina:posterior_fornix","vagina:pouch_douglas","vulva:external_urethral_orifice","vulva:urethra"]},{"id":"pelvis:rectocele","glossary":"pelvis","term_en":"rectocele","term_ru":"ректоцеле","pronunciation_ru":"РЭК-то-сил","definition_ru":"Пролапс задней стенки влагалища с выпячиванием со стороны прямой кишки.","tags":["pathology","pelvis","vagina","pelvic-floor"],"related":["pelvis:cystocele","pelvis:enterocele"]},{"id":"pelvis:enterocele","glossary":"pelvis","term_en":"enterocele","term_ru":"энтероцеле","pronunciation_ru":"ЭН-тэ-ро-сил","definition_ru":"Грыжевое выпячивание брюшины с кишечными петлями в область влагалища или тазового дна.","tags":["pathology","pelvis","vagina","pelvic-floor"],"related":["pelvis:cystocele","pelvis:rectocele","vagina:culdocentesis","vagina:posterior_fornix","vagina:pouch_douglas"]},{"id":"pelvis:uterine_prolapse","glossary":"pelvis","term_en":"uterine prolapse","term_ru":"опущение или выпадение матки","pronunciation_ru":"Ю-тэ-рин ПРО-лэпс","definition_ru":"Смещение матки книзу при недостаточности поддерживающих структур тазового дна.","tags":["pathology","pelvis","uterus","pelvic-floor"],"related":["uterus:cardinal_ligament","uterus:uterosacral_ligament"]},{"id":"pelvis:stress_urinary_incontinence","glossary":"pelvis","term_en":"stress urinary incontinence","term_ru":"стрессовое недержание мочи","pronunciation_ru":"стрэс Ю-ри-нэ-ри ин-КОН-ти-нэнс","definition_ru":"Непроизвольное выделение мочи при повышении внутрибрюшного давления; лекция относит его к патологии тазового дна.","tags":["pathology","pelvis","pelvic-floor","urinary"],"related":["pelvis:cystocele","pelvis:external_urethral_sphincter"]},{"id":"pelvis:obstetric_perineal_tear","glossary":"pelvis","term_en":"obstetric perineal tear","term_ru":"акушерский разрыв промежности","pronunciation_ru":"об-СТЭ-трик пэ-ри-НИ-эл тЭР","definition_ru":"Разрыв тканей промежности при родах; в лекции выделены степени I–IV.","tags":["pathology","pelvis","obstetrics","labor"],"related":["cycle:pelvimetry","pelvis:cephalopelvic_disproportion","pelvis:obstructed_labor"]}]