[{"id":"tubes:fallopian_tube","glossary":"tubes","term_en":"Fallopian tube (uterine tube)","term_ru":"маточная труба","pronunciation_ru":"фэ-ЛОУ-пи-эн тьюб","definition_ru":"Парная трубчатая структура длиной 10–12 см; захватывает ооцит, обеспечивает оплодотворение и транспорт эмбриона к матке.","tags":["anatomy","tubes","fertility"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:mesosalpinx","glossary":"tubes","term_en":"mesosalpinx","term_ru":"мезосальпинкс","pronunciation_ru":"мэ-зоу-СЭЛ-пинкс","definition_ru":"Часть широкой связки матки, в верхнем крае которой располагаются маточные трубы.","tags":["anatomy","tubes","ligaments"],"related":["ovaries:mesovarium","uterus:broad_ligament"]},{"id":"tubes:interstitial_part","glossary":"tubes","term_en":"interstitial (intramural) part of the tube","term_ru":"интерстициальная, или внутристеночная, часть трубы","pronunciation_ru":"ин-тэр-СТИ-шэл парт","definition_ru":"Часть маточной трубы, проходящая в стенке матки.","tags":["anatomy","tubes"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:tubal_isthmus","glossary":"tubes","term_en":"isthmus of the fallopian tube","term_ru":"перешеек маточной трубы","pronunciation_ru":"ИС-мэс ов зэ фэ-ЛОУ-пи-эн тьюб","definition_ru":"Узкий участок маточной трубы между интерстициальной частью и ампулой.","tags":["anatomy","tubes"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:ampulla","glossary":"tubes","term_en":"ampulla of the fallopian tube","term_ru":"ампула маточной трубы","pronunciation_ru":"эм-ПАЛ-а ов зэ фэ-ЛОУ-пи-эн тьюб","definition_ru":"Расширенная часть трубы; в лекции указана как наиболее частое место оплодотворения.","tags":["anatomy","tubes","fertility"],"related":["tubes:chromopertubation","tubes:ciliated_cells","tubes:fallopian_tube","tubes:fertilization","tubes:fimbriae","tubes:infundibulum","tubes:interstitial_part","tubes:peg_cells","tubes:peristalsis","tubes:tubal_infertility","tubes:tubal_isthmus","tubes:tubal_mucosa"]},{"id":"tubes:infundibulum","glossary":"tubes","term_en":"infundibulum of the fallopian tube","term_ru":"воронка маточной трубы","pronunciation_ru":"ин-фан-ДИБ-ю-лэм","definition_ru":"Дистальная воронкообразная часть трубы с фимбриями.","tags":["anatomy","tubes","fertility"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:fimbriae","glossary":"tubes","term_en":"fimbriae","term_ru":"фимбрии маточной трубы","pronunciation_ru":"ФИМ-бри-и","definition_ru":"Пальцевидные выросты воронки трубы, участвующие в захвате ооцита.","tags":["anatomy","tubes","fertility"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:tubal_mucosa","glossary":"tubes","term_en":"tubal mucosa","term_ru":"слизистая оболочка маточной трубы","pronunciation_ru":"ТЬЮ-бэл мью-КОУ-за","definition_ru":"Слизистая оболочка трубы с продольными складками, наиболее выраженными в ампуле.","tags":["histology","tubes"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:ciliated_cells","glossary":"tubes","term_en":"ciliated cells","term_ru":"реснитчатые клетки","pronunciation_ru":"СИ-ли-эй-тид сэлз","definition_ru":"Клетки эпителия трубы; движение ресничек участвует в продвижении содержимого в сторону матки.","tags":["histology","tubes","fertility"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:peg_cells","glossary":"tubes","term_en":"secretory (peg) cells","term_ru":"секреторные клетки маточной трубы","pronunciation_ru":"си-КРИ-тэ-ри пэг сэлз","definition_ru":"Секреторные клетки слизистой трубы, перечисленные в лекции.","tags":["histology","tubes","fertility"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:peristalsis","glossary":"tubes","term_en":"peristalsis","term_ru":"перистальтика","pronunciation_ru":"пэ-ри-СТЭЛ-сис","definition_ru":"Волнообразные сокращения мышечной оболочки; вместе с движением ресничек обеспечивают транспорт по трубе.","tags":["physiology","tubes","muscle","fertility"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:fertilization","glossary":"tubes","term_en":"fertilization","term_ru":"оплодотворение","pronunciation_ru":"фёр-ти-лай-ЗЭЙ-шэн","definition_ru":"Слияние половых клеток; лекция указывает ампулу трубы как наиболее частое место.","tags":["physiology","tubes","fertility"],"related":["tubes:ampulla","tubes:chromopertubation"]},{"id":"tubes:salpingitis","glossary":"tubes","term_en":"salpingitis","term_ru":"сальпингит","pronunciation_ru":"сэл-пин-ДЖАЙ-тис","definition_ru":"Воспаление маточной трубы, связанное в лекции с PID и его осложнениями.","tags":["pathology","tubes","inflammation","infection"],"related":["cervix:cervicitis","tubes:pid","tubes:pyosalpinx"]},{"id":"tubes:pid","glossary":"tubes","term_en":"pelvic inflammatory disease (PID)","term_ru":"воспалительное заболевание органов малого таза","pronunciation_ru":"ПЭЛ-вик ин-ФЛЭМ-э-то-ри ди-ЗИЗ","definition_ru":"Воспаление органов малого таза; в лекции связано с сальпингитом, гидросальпинксом, пиосальпинксом и трубным бесплодием.","tags":["pathology","tubes","pelvis","inflammation","infection"],"related":["cervix:cervicitis","tubes:pyosalpinx","tubes:salpingitis","tubes:tubo_ovarian_abscess"]},{"id":"tubes:hydrosalpinx","glossary":"tubes","term_en":"hydrosalpinx","term_ru":"гидросальпинкс","pronunciation_ru":"хай-дроу-СЭЛ-пинкс","definition_ru":"Скопление жидкости в маточной трубе, перечисленное в лекции среди осложнений PID.","tags":["pathology","tubes","infertility"],"related":["tubes:tubal_infertility","uterus:asherman_syndrome"]},{"id":"tubes:pyosalpinx","glossary":"tubes","term_en":"pyosalpinx","term_ru":"пиосальпинкс","pronunciation_ru":"пай-оу-СЭЛ-пинкс","definition_ru":"Скопление гнойного содержимого в маточной трубе; осложнение воспаления.","tags":["pathology","tubes","infection"],"related":["tubes:pid","tubes:salpingitis","tubes:tubo_ovarian_abscess"]},{"id":"tubes:tubo_ovarian_abscess","glossary":"tubes","term_en":"tubo-ovarian abscess","term_ru":"тубоовариальный абсцесс","pronunciation_ru":"ТЬЮ-бо-оу-ВЭ-ри-эн ЭБ-сэс","definition_ru":"Абсцесс в области трубы и яичника, перечисленный среди осложнений PID.","tags":["pathology","tubes","ovary","infection"],"related":["tubes:pid","tubes:pyosalpinx"]},{"id":"tubes:tubal_infertility","glossary":"tubes","term_en":"tubal factor infertility","term_ru":"трубный фактор бесплодия","pronunciation_ru":"ТЬЮ-бэл ФЭК-тэр ин-фэр-ТИ-ли-ти","definition_ru":"Бесплодие, связанное с поражением или нарушением проходимости маточных труб.","tags":["pathology","tubes","fertility","infertility"],"related":["tubes:ampulla","tubes:chromopertubation","tubes:hydrosalpinx"]},{"id":"tubes:ectopic_pregnancy","glossary":"tubes","term_en":"ectopic pregnancy","term_ru":"внематочная беременность","pronunciation_ru":"эк-ТОП-ик ПРЭГ-нэн-си","definition_ru":"Имплантация беременности вне полости матки; лекция отмечает частую ампулярную локализацию и триаду аменореи, боли и кровотечения.","tags":["pathology","tubes","pregnancy","emergency"],"related":["tubes:hemoperitoneum","tubes:methotrexate"]},{"id":"tubes:amenorrhea","glossary":"tubes","term_en":"amenorrhea","term_ru":"аменорея","pronunciation_ru":"эй-мэн-о-РИ-а","definition_ru":"Отсутствие менструаций; в лекции входит в триаду симптомов внематочной беременности.","tags":["clinical","menstrual-cycle","pregnancy"],"related":["cervix:cerclage","cervix:cervical_insufficiency"]},{"id":"tubes:hemoperitoneum","glossary":"tubes","term_en":"hemoperitoneum","term_ru":"гемоперитонеум","pronunciation_ru":"хи-мо-пэ-ри-тоу-НИ-эм","definition_ru":"Наличие крови в брюшной полости; в лекции связано с разрывом внематочной беременности.","tags":["pathology","emergency","tubes","bleeding"],"related":["ovaries:ovarian_torsion","tubes:ectopic_pregnancy"]},{"id":"tubes:methotrexate","glossary":"tubes","term_en":"methotrexate","term_ru":"метотрексат","pronunciation_ru":"мэ-тоу-ТРЭК-сэйт","definition_ru":"Препарат, названный в лекции одним из вариантов лечения внематочной беременности у подходящих пациенток.","tags":["pharmacology","tubes","pregnancy","clinical"],"related":["cervix:cerclage","tubes:ectopic_pregnancy"]},{"id":"tubes:salpingectomy","glossary":"tubes","term_en":"salpingectomy","term_ru":"сальпингэктомия","pronunciation_ru":"сэл-пин-ДЖЭК-то-ми","definition_ru":"Хирургическое удаление маточной трубы, перечисленное в лекции среди вариантов лечения внематочной беременности.","tags":["clinical","tubes","surgery"],"related":["tubes:chromopertubation","tubes:salpingostomy"]},{"id":"tubes:salpingostomy","glossary":"tubes","term_en":"salpingostomy","term_ru":"сальпингостомия","pronunciation_ru":"сэл-пин-ГОС-то-ми","definition_ru":"Операция с формированием отверстия в маточной трубе, перечисленная в лекции.","tags":["clinical","tubes","surgery"],"related":["tubes:chromopertubation","tubes:salpingectomy"]},{"id":"tubes:tubal_cancer","glossary":"tubes","term_en":"tubal cancer","term_ru":"рак маточной трубы","pronunciation_ru":"ТЬЮ-бэл КЭН-сэр","definition_ru":"Злокачественная опухоль маточной трубы; лекция упоминает STIC как предшественник высокозлокачественного серозного рака яичника.","tags":["pathology","tubes","oncology"],"related":["cervix:cervical_cancer","tubes:stic"]},{"id":"tubes:stic","glossary":"tubes","term_en":"serous tubal intraepithelial carcinoma (STIC)","term_ru":"серозная тубарная интраэпителиальная карцинома","pronunciation_ru":"СИ-ри-эс ТЬЮ-бэл ин-тра-э-пи-ТИ-ли-эл кар-си-НО-ма","definition_ru":"Предшественник, который лекция связывает с высокозлокачественным серозным раком яичника.","tags":["pathology","tubes","ovary","oncology"],"related":["ovaries:afp","ovaries:brca","ovaries:krukenberg_tumour","ovaries:ovarian_tumours","tubes:tubal_cancer"]},{"id":"tubes:hysterosalpingography","glossary":"tubes","term_en":"hysterosalpingography (HSG)","term_ru":"гистеросальпингография","pronunciation_ru":"хис-тэ-роу-сэл-пин-ГОГ-рэ-фи","definition_ru":"Метод оценки полости матки и проходимости труб, указанный в лекции.","tags":["diagnostics","tubes","uterus","fertility"],"related":["uterus:endometriosis","uterus:implantation_window"]},{"id":"tubes:chromopertubation","glossary":"tubes","term_en":"chromopertubation","term_ru":"хромопертубация","pronunciation_ru":"кроу-мо-пэр-тю-БЭЙ-шэн","definition_ru":"Проверка проходимости труб с окрашенным раствором, указанная в лекции при лапароскопии.","tags":["diagnostics","tubes","fertility","surgery"],"related":["tubes:ampulla","tubes:ciliated_cells","tubes:fallopian_tube","tubes:fertilization","tubes:fimbriae","tubes:infundibulum","tubes:interstitial_part","tubes:peg_cells","tubes:peristalsis","tubes:salpingectomy","tubes:salpingostomy","tubes:tubal_infertility","tubes:tubal_isthmus","tubes:tubal_mucosa"]}]